"end":{"line":69,"column":1}},"key":"gTLbeYkVwC"}],"key":"JxVyKV6nHA"},{"type":"paragraph","position":{"start":{"line":72,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"text","value":"BuildingMOTIF resolves the ontology’s dependencies with ","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"Qky6V7zexT"},{"type":"link","url":"https://ontoenv.gtf.fyi","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"children":[{"type":"text","value":"OntoEnv","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"DOgTHD5Qmc"}],"urlSource":"https://ontoenv.gtf.fyi","key":"EQcavSXt87"},{"type":"text","value":" and validates with\n","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"KSXGNi78Cq"},{"type":"link","url":"https://shifty.gtf.fyi","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"children":[{"type":"text","value":"shifty","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"hpFF1Cw4rZ"}],"urlSource":"https://shifty.gtf.fyi","key":"vqcypoZc58"},{"type":"text","value":", both of which are self-contained Rust extensions, so there is nothing else to install and no Java is required.","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"wZSyljrjq7"}],"key":"Ngs7sSu1Bl"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"BuildingMOTIF installation","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"eFG4ymxI3a"}],"key":"OyYlMOmHUE"},{"type":"paragraph","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"text","value":"To install the ","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"dxZ59sYN2C"},{"type":"inlineCode","value":"buildingmotif","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"oU0xFt17OB"},{"type":"text","value":" library, you can use the following command:","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"g8FMkG8qiq"}],"key":"Z2iQATBvp4"},{"type":"code","lang":"shell","value":"pip install 'buildingmotif @ git+https://github.com/NREL/buildingmotif.git@gtf-buildingmotif'","position":{"start":{"line":79,"column":1},"end":{"line":81,"column":1}},"key":"N0K4LNE1hx"}],"class":"dropdown","key":"RLUsL3C6V9"}],"key":"p8UlzlP0cG"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from buildingmotif import BuildingMOTIF\nfrom buildingmotif.dataclasses import Library, Model\nimport logging\n\n# Create a BuildingMOTIF object. This validates with the \"pyshifty\" SHACL\n# engine by default, so there is nothing else to install and no Java required.\nbm = BuildingMOTIF('sqlite://', log_level=logging.ERROR)\n\n# load 223P library. We will load a recent copy from the models.open223.info\n# git repository; later, we will load this from the location of the actual standard.\n# BuildingMOTIF uses OntoEnv to fetch the ontologies 223P depends on (QUDT, SHACL, ...).\ns223 = Library.from_ontology(\"https://open223.info/223p.ttl\", infer_templates=False, run_shacl_inference=False)\n\n# load the model into the BuildingMOTIF instance\nmodel = Model.from_file(\"https://models.open223.info/guideline36-2021-A-3.ttl\")\n\n# a model's manifest lists the libraries it should conform to\nmodel.manifest.add(s223)\n\n# validate the model against its manifest\nctx = model.validate()\n\n# print the validation result\nprint(f\"Model is valid: {ctx.valid}\")\n\n# if the model is invalid, print the validation report\nif not ctx.valid:\n    print(ctx.report_string[:1000]) # first 1000 characters of the report\n\n# BuildingMOTIF can also interpret the report to provide recommendations on fixes\nfor focus_node, diffs in ctx.get_reasons_with_severity(\"Violation\").items():\n    if len(diffs) == 0:\n        continue\n    print(focus_node)\n    for diff in diffs:\n        print(\"  - \" + diff.reason())","key":"pP92LCBdVS"},{"type":"outputs","id":"aGeg7s5-KHGMe1d3WDuqT","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Model is valid: True\n"},"key":"Q0U9inv93o"}],"key":"XigOzEF4iZ"}],"key":"aXwhqeAVaX"}],"key":"JAzVFRTVHW"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"ASHRAE Guideline 36-2021 A-2 VAV Terminal Unit with Reheat","url":"/guideline36-2021-a-2","group":"Example Systems"},"next":{"title":"ASHRAE Guideline 36-2021 A-4 Parallel Fan-Powered Terminal Unit, Variable Volume Fan","url":"/guideline36-2021-a-4","group":"Example Systems"}}},"domain":"http://localhost:3000"}