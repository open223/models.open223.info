"end":{"line":69,"column":1}},"key":"DWcidoIfZs"}],"key":"Rlwp6EzPA3"},{"type":"paragraph","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"children":[{"type":"text","value":"BuildingMOTIF resolves the ontology’s dependencies and performs SHACL validation and inference","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"fGJkin1w3t"}],"key":"vhEor7Wwuh"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"BuildingMOTIF installation","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"key":"bv7Ji9tayR"}],"key":"qqtE4ZHU3F"},{"type":"paragraph","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"text","value":"To install the ","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"MBTYkPWR7L"},{"type":"inlineCode","value":"buildingmotif","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"LaNOW8gmq2"},{"type":"text","value":" library, you can use the following command:","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"hNLsY4kMX5"}],"key":"ndHKh1qd9R"},{"type":"code","lang":"shell","value":"pip install 'buildingmotif @ git+https://github.com/NREL/buildingmotif.git@gtf-buildingmotif'","position":{"start":{"line":78,"column":1},"end":{"line":80,"column":1}},"key":"IuwxGhTSwU"}],"class":"dropdown","key":"yXU5P7ScNB"}],"key":"hiCXpsD6OU"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from buildingmotif import BuildingMOTIF\nfrom buildingmotif.dataclasses import Library, Model\nimport logging\n\n# Create a BuildingMOTIF object. This validates with the \"pyshifty\" SHACL engine by default\nbm = BuildingMOTIF('sqlite://', log_level=logging.ERROR)\n\n# load 223P library. We will load a recent copy from the models.open223.info\n# git repository; later, we will load this from the location of the actual standard.\n# BuildingMOTIF uses OntoEnv to fetch the ontologies 223P depends on (QUDT, SHACL, ...).\ns223 = Library.from_ontology(\"https://open223.info/223p.ttl\", infer_templates=False, run_shacl_inference=False)\n\n# load the model into the BuildingMOTIF instance\nmodel = Model.from_file(\"https://models.open223.info/guideline36-2021-A-3.ttl\")\n\n# a model's manifest lists the libraries it should conform to\nmodel.manifest.add(s223)\n\n# validate the model against its manifest\nctx = model.validate()\n\n# print the validation result\nprint(f\"Model is valid: {ctx.valid}\")\n\n# if the model is invalid, print the validation report\nif not ctx.valid:\n    print(ctx.report_string[:1000]) # first 1000 characters of the report\n\n# BuildingMOTIF can also interpret the report to provide recommendations on fixes\nfor focus_node, diffs in ctx.get_reasons_with_severity(\"Violation\").items():\n    if len(diffs) == 0:\n        continue\n    print(focus_node)\n    for diff in diffs:\n        print(\"  - \" + diff.reason())","key":"w1jK1nC5vq"},{"type":"outputs","id":"iqcJOScH3dDjf_En3M7BF","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Model is valid: True\n"},"key":"phcLU0wG01"}],"key":"u8C44CUHn0"}],"key":"fPzLAOoDFn"}],"key":"fhQP62lrpg"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"ASHRAE Guideline 36-2021 A-2 VAV Terminal Unit with Reheat","url":"/guideline36-2021-a-2","group":"Example Systems"},"next":{"title":"ASHRAE Guideline 36-2021 A-4 Parallel Fan-Powered Terminal Unit, Variable Volume Fan","url":"/guideline36-2021-a-4","group":"Example Systems"}}},"domain":"http://localhost:3000"}