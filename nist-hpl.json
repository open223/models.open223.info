lumn":1}},"key":"oySvtGR3VF"}],"key":"nzioy9a8L9"},{"type":"paragraph","position":{"start":{"line":80,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"BuildingMOTIF resolves the ontology’s dependencies with ","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"IHqsJFfcp9"},{"type":"link","url":"https://ontoenv.gtf.fyi","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"text","value":"OntoEnv","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"AAt7Sz99RQ"}],"urlSource":"https://ontoenv.gtf.fyi","key":"Ko3WTg1VlX"},{"type":"text","value":" and validates with\n","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"VqqL6Su2Fo"},{"type":"link","url":"https://shifty.gtf.fyi","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"text","value":"shifty","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"qTpR4wQGsj"}],"urlSource":"https://shifty.gtf.fyi","key":"UOr0t0uFMc"},{"type":"text","value":", both of which are self-contained Rust extensions, so there is nothing else to install and no Java is required.","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"YiTjklZyqr"}],"key":"MPs0nUlR0X"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"BuildingMOTIF installation","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"uLzMZxVyS6"}],"key":"ZMh53H9w1B"},{"type":"paragraph","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"text","value":"To install the ","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"jCRSQBhVlj"},{"type":"inlineCode","value":"buildingmotif","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"orvYLtzYcC"},{"type":"text","value":" library, you can use the following command:","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"YdqjY52d4f"}],"key":"tqlxGuGsxQ"},{"type":"code","lang":"shell","value":"pip install 'buildingmotif @ git+https://github.com/NREL/buildingmotif.git@gtf-buildingmotif'","position":{"start":{"line":87,"column":1},"end":{"line":89,"column":1}},"key":"wHtQltsY1r"}],"class":"dropdown","key":"IBg8akm3cA"}],"key":"BvbeXvnCsr"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from buildingmotif import BuildingMOTIF\nfrom buildingmotif.dataclasses import Library, Model\nfrom datetime import datetime, timezone\nimport logging\n\n# Create a BuildingMOTIF object. This validates with the \"pyshifty\" SHACL\n# engine by default, so there is nothing else to install and no Java required.\nbm = BuildingMOTIF('sqlite://', log_level=logging.ERROR)\n\n# load 223P library. We will load a recent copy from the models.open223.info\n# git repository; later, we will load this from the location of the actual standard.\n# BuildingMOTIF uses OntoEnv to fetch the ontologies 223P depends on (QUDT, SHACL, ...).\ns223 = Library.from_ontology(\"https://open223.info/223p.ttl\", infer_templates=False, run_shacl_inference=False)\n\n# load the model into the BuildingMOTIF instance. This page pins the exact copy\n# it was built and validated against, so it stays reproducible as the site moves\n# on. To run this against the current published model, use the permanent URL:\n#\n#     model = Model.from_file(\"https://models.open223.info/NIST-HPL.ttl\")\n#\nmodel = Model.from_file(\"https://raw.githubusercontent.com/open223/models.open223.info/48c95b6c8575654872eb37abb7dca40cd50636ab/models/NIST-HPL.ttl\")\n\n# a model's manifest lists the libraries it should conform to\nmodel.manifest.add(s223)\n\n# validate the model against its manifest\nctx = model.validate()\n\n# print when validation completed\nprint(f\"Validation run at: {datetime.now(timezone.utc).isoformat(timespec='seconds')}\")\n\n# print the validation result\nprint(f\"Model is valid: {ctx.valid}\")\n\n# if the model is invalid, print the validation report\nif not ctx.valid:\n    print(ctx.report_string[:1000]) # first 1000 characters of the report\n\n# BuildingMOTIF can also interpret the report to provide recommendations on fixes\nfor focus_node, diffs in ctx.get_reasons_with_severity(\"Violation\").items():\n    if len(diffs) == 0:\n        continue\n    print(focus_node)\n    for diff in diffs:\n        print(\"  - \" + diff.reason())","key":"JtCFAqEEjq"},{"type":"code","lang":"text","value":"Validation run at: 2026-09-21T16:21:04+00:00\nModel is valid: False\nValidation Report\nConforms: False\n\nViolation result in http://data.ashrae.org/standard223#ConnectionPoint (<http://example.org/HPL#FinnedHeatExchanger_A_ICP>):\n  Path: <http://data.ashrae.org/standard223#isConnectionPointOf>\n  Severity: Violation\n  Value: <http://example.org/HPL#FinnedHeatExchanger_A_ICP>\n  Message: at least 1 value(s) required along <http://data.ashrae.org/standard223#isConnectionPointOf>, found 0\n\nViolation result in http://data.ashrae.org/standard223#ConnectionPoint (<http://example.org/HPL#FinnedHeatExchanger_A_OCP>):\n  Path: <http://data.ashrae.org/standard223#isConnectionPointOf>\n  Severity: Violation\n  Value: <http://example.org/HPL#FinnedHeatExchanger_A_OCP>\n  Message: at least 1 value(s) required along <http://data.ashrae.org/standard223#isConnectionPointOf>, found 0\n\nViolation result in http://data.ashrae.org/standard223#ConnectionPoint (<http://example.org/HPL#FinnedHeatExchanger_R_CP_1>):\n  Path: <http://data.ashrae.org/standard223#isConnectionPointOf>\n  Se\nhttp://example.org/HPL#FinnedHeatExchanger_A_ICP\n  - <http://example.org/HPL#FinnedHeatExchanger_A_ICP> at least 1 value(s) required along <http://data.ashrae.org/standard223#isConnectionPointOf>, found 0\nhttp://example.org/HPL#FinnedHeatExchanger_A_OCP\n  - <http://example.org/HPL#FinnedHeatExchanger_A_OCP> at least 1 value(s) required along <http://data.ashrae.org/standard223#isConnectionPointOf>, found 0\nhttp://example.org/HPL#FinnedHeatExchanger_R_CP_1\n  - <http://example.org/HPL#FinnedHeatExchanger_R_CP_1> at least 1 value(s) required along <http://data.ashrae.org/standard223#isConnectionPointOf>, found 0\nhttp://example.org/HPL#FinnedHeatExchanger_R_CP_2\n  - <http://example.org/HPL#FinnedHeatExchanger> must be an instance of <http://data.ashrae.org/standard223#Connectable>\nhttp://example.org/HPL#HeatExchanger\n  - <http://example.org/HPL#HeatExchanger> none of 3 alternative(s) satisfied\nhttp://example.org/HPL#OA_Unit\n  - <http://example.org/HPL#FinnedHeatExchanger> must satisfy `instance of <http://data.ashrae.org/standard223#Equipment> or instance of <http://data.ashrae.org/standard223#Junction>`\nhttp://example.org/HPL#PressureSensor_8\n  - <http://example.org/HPL#FinnedHeatExchanger> must satisfy `(not an instance of <http://data.ashrae.org/standard223#Connection> and instance of <http://data.ashrae.org/standard223#Connectable> and not an instance of <http://data.ashrae.org/standard223#ConnectionPoint>) or (not an instance of <http://data.ashrae.org/standard223#Connectable> and instance of <http://data.ashrae.org/standard223#Connection> and not an instance of <http://data.ashrae.org/standard223#ConnectionPoint>) or (not an instance of <http://data.ashrae.org/standard223#Connectable> and not an instance of <http://data.ashrae.org/standard223#Connection> and instance of <http://data.ashrae.org/standard223#ConnectionPoint>)`\nhttp://example.org/HPL#TemperatureSensor_15\n  - <http://example.org/HPL#FinnedHeatExchanger> must satisfy `(not an instance of <http://data.ashrae.org/standard223#Connection> and instance of <http://data.ashrae.org/standard223#Connectable> and not an instance of <http://data.ashrae.org/standard223#ConnectionPoint>) or (not an instance of <http://data.ashrae.org/standard223#Connectable> and instance of <http://data.ashrae.org/standard223#Connection> and not an instance of <http://data.ashrae.org/standard223#ConnectionPoint>) or (not an instance of <http://data.ashrae.org/standard223#Connectable> and not an instance of <http://data.ashrae.org/standard223#Connection> and instance of <http://data.ashrae.org/standard223#ConnectionPoint>)`\nhttp://example.org/HPL#TemperatureSensor_30\n  - <http://example.org/HPL#FinnedHeatExchanger> must satisfy `(not an instance of <http://data.ashrae.org/standard223#Connection> and instance of <http://data.ashrae.org/standard223#Connectable> and not an instance of <http://data.ashrae.org/standard223#ConnectionPoint>) or (not an instance of <http://data.ashrae.org/standard223#Connectable> and instance of <http://data.ashrae.org/standard223#Connection> and not an instance of <http://data.ashrae.org/standard223#ConnectionPoint>) or (not an instance of <http://data.ashrae.org/standard223#Connectable> and not an instance of <http://data.ashrae.org/standard223#Connection> and instance of <http://data.ashrae.org/standard223#ConnectionPoint>)`\n","class":"validation-output","key":"N57aAQHmOE"}],"key":"cZtjATUB8T"}],"key":"zZ5Md9xgfJ"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"NREL Example Building","url":"/nrel-example","group":"Example Buildings"},"next":{"title":"Intelligent Buildings Agents Laboratory (IBAL)","url":"/nist-ibal","group":"Example Buildings"}}},"domain":"http://localhost:3000"}