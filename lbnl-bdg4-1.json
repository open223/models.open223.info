validate-model","implicit":true,"key":"K6YwakCln3"},{"type":"paragraph","position":{"start":{"line":86,"column":1},"end":{"line":87,"column":1}},"children":[{"type":"text","value":"This code uses the ","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"d9qUb1smZF"},{"type":"link","url":"https://github.com/NREL/BuildingMOTIF","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"text","value":"BuildingMOTIF","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"HqdZveUTpH"}],"urlSource":"https://github.com/NREL/BuildingMOTIF","error":true,"key":"n6cpjG9P3y"},{"type":"text","value":" library to load the 223P ontology and the model file into a temporary in-memory instance.\nIt then validates the model against the ontology. If the model is invalid, it will print the validation report.","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"m5V0JNTxCn"}],"key":"sWZgh97vfl"},{"type":"paragraph","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"children":[{"type":"text","value":"BuildingMOTIF resolves the ontology’s dependencies and performs SHACL validation and inference","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"key":"wVo34VNoNJ"}],"key":"i7oF5p7y9B"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"BuildingMOTIF installation","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"DqqZNaVITo"}],"key":"hGFeV2oAiM"},{"type":"paragraph","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"text","value":"To install the ","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"key":"Oy7JEM1Vd5"},{"type":"inlineCode","value":"buildingmotif","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"key":"zqsVUw1TI2"},{"type":"text","value":" library, you can use the following command:","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"key":"MFrsX0QsWE"}],"key":"vnOMdZiDOQ"},{"type":"code","lang":"shell","value":"pip install 'buildingmotif @ git+https://github.com/NREL/buildingmotif.git@gtf-buildingmotif'","position":{"start":{"line":95,"column":1},"end":{"line":97,"column":1}},"key":"yMGOd7sk9d"}],"class":"dropdown","key":"J6szhLz4Nx"}],"key":"PA7B6mnPAz"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from buildingmotif import BuildingMOTIF\nfrom buildingmotif.dataclasses import Library, Model\nimport logging\n\n# Create a BuildingMOTIF object. This validates with the \"pyshifty\" SHACL engine by default\nbm = BuildingMOTIF('sqlite://', log_level=logging.ERROR)\n\n# load 223P library. We will load a recent copy from the models.open223.info\n# git repository; later, we will load this from the location of the actual standard.\n# BuildingMOTIF uses OntoEnv to fetch the ontologies 223P depends on (QUDT, SHACL, ...).\ns223 = Library.from_ontology(\"https://open223.info/223p.ttl\", infer_templates=False, run_shacl_inference=False)\n\n# load the model into the BuildingMOTIF instance\nmodel = Model.from_file(\"https://models.open223.info/lbnl-bdg4-1.ttl\")\n\n# a model's manifest lists the libraries it should conform to\nmodel.manifest.add(s223)\n\n# validate the model against its manifest\nctx = model.validate()\n\n# print the validation result\nprint(f\"Model is valid: {ctx.valid}\")\n\n# if the model is invalid, print the validation report\nif not ctx.valid:\n    print(ctx.report_string[:1000]) # first 1000 characters of the report\n\n# BuildingMOTIF can also interpret the report to provide recommendations on fixes\nfor focus_node, diffs in ctx.get_reasons_with_severity(\"Violation\").items():\n    if len(diffs) == 0:\n        continue\n    print(focus_node)\n    for diff in diffs:\n        print(\"  - \" + diff.reason())","key":"jZgEfREvqw"},{"type":"outputs","id":"2DLAau-LltG4yOXT_pSd4","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Model is valid: False\nValidation Report\nConforms: False\n\nViol...","hash":"b9f9a219bcf3dfb39a1095776f2f4d68","path":"/build/b9f9a219bcf3dfb39a1095776f2f4d68.txt"},"key":"RpRllIEAwt"}],"key":"DUBIQ7NKCd"}],"key":"LatFcnyGAd"}],"key":"qIUURhDpVa"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"PNNL Example Building 3 Model 2","url":"/pnnl-bdg3-2","group":"Example Buildings"},"next":{"title":"NREL Example Building","url":"/nrel-example","group":"Example Buildings"}}},"domain":"http://localhost:3000"}