{"line":66,"column":1}},"key":"p2d8H5x9TT"},{"type":"link","url":"https://ontoenv.gtf.fyi","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"text","value":"OntoEnv","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"EUu1OcMDlq"}],"urlSource":"https://ontoenv.gtf.fyi","key":"MK7ivyt2Zt"},{"type":"text","value":" and validates with\n","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"M5gtqOtNgz"},{"type":"link","url":"https://shifty.gtf.fyi","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"text","value":"shifty","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"sqFnXamF0c"}],"urlSource":"https://shifty.gtf.fyi","key":"wLnB4RQtd6"},{"type":"text","value":", both of which are self-contained Rust extensions, so there is nothing else to install and no Java is required.","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"wQIo4cANaQ"}],"key":"hQgxDQWwi7"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"BuildingMOTIF installation","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"key":"yfXgrMk1Y8"}],"key":"oyhnLBLz71"},{"type":"paragraph","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"text","value":"To install the ","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"hIN2tryrzA"},{"type":"inlineCode","value":"buildingmotif","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"C9LrWXyzvS"},{"type":"text","value":" library, you can use the following command:","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"bXRB681Jad"}],"key":"Fdudj1609w"},{"type":"code","lang":"shell","value":"pip install 'buildingmotif @ git+https://github.com/NREL/buildingmotif.git@gtf-buildingmotif'","position":{"start":{"line":73,"column":1},"end":{"line":75,"column":1}},"key":"difh1DeBKx"}],"class":"dropdown","key":"XYfxQDuU7n"}],"key":"Zswwdl0Otk"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from buildingmotif import BuildingMOTIF\nfrom buildingmotif.dataclasses import Library, Model\nimport logging\n\n# Create a BuildingMOTIF object. This validates with the \"pyshifty\" SHACL\n# engine by default, so there is nothing else to install and no Java required.\nbm = BuildingMOTIF('sqlite://', log_level=logging.ERROR)\n\n# load 223P library. We will load a recent copy from the models.open223.info\n# git repository; later, we will load this from the location of the actual standard.\n# BuildingMOTIF uses OntoEnv to fetch the ontologies 223P depends on (QUDT, SHACL, ...).\ns223 = Library.from_ontology(\"https://open223.info/223p.ttl\", infer_templates=False, run_shacl_inference=False)\n\n# load the model into the BuildingMOTIF instance\nmodel = Model.from_file(\"https://models.open223.info/guideline36-2021-A-8.ttl\")\n\n# a model's manifest lists the libraries it should conform to\nmodel.manifest.add(s223)\n\n# validate the model against its manifest\nctx = model.validate()\n\n# print the validation result\nprint(f\"Model is valid: {ctx.valid}\")\n\n# if the model is invalid, print the validation report\nif not ctx.valid:\n    print(ctx.report_string[:1000]) # first 1000 characters of the report\n\n# BuildingMOTIF can also interpret the report to provide recommendations on fixes\nfor focus_node, diffs in ctx.get_reasons_with_severity(\"Violation\").items():\n    if len(diffs) == 0:\n        continue\n    print(focus_node)\n    for diff in diffs:\n        print(\"  - \" + diff.reason())","key":"bkkw4OBbk1"},{"type":"outputs","id":"0DqxzDxkPnSE8kpxd2b5B","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Model is valid: True\n"},"key":"uajsC2ShiL"}],"key":"iQfyGhpVXb"}],"key":"g0oQ8AM0Xq"}],"key":"NMX88LMoZO"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"ASHRAE Guideline 36-2021 A-7 Dual Duct Terminal Unit with Inlet Sensors","url":"/guideline36-2021-a-7","group":"Example Systems"},"next":{"title":"ASHRAE Guideline 36-2021 A-9 Multiple Zone VAV Air Handling Unit","url":"/guideline36-2021-a-9","group":"Example Systems"}}},"domain":"http://localhost:3000"}