6,"column":1},"end":{"line":66,"column":1}},"key":"O1R3T4pT0g"}],"key":"ygFt2QqOdO"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"BuildingMOTIF installation","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"QNf6gvEO56"}],"key":"WPsf5nFS1O"},{"type":"paragraph","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"text","value":"To install the ","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"uLF3pj7fDi"},{"type":"inlineCode","value":"buildingmotif","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"AH9enGsu1P"},{"type":"text","value":" library, you can use the following command:","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"bHHbwBfwLt"}],"key":"apBxmvcn3f"},{"type":"code","lang":"shell","value":"pip install 'buildingmotif @ git+https://github.com/NREL/buildingmotif.git@gtf-buildingmotif'","position":{"start":{"line":72,"column":1},"end":{"line":74,"column":1}},"key":"if3yYZiLe8"}],"class":"dropdown","key":"PCB5dg2htu"}],"key":"zTLEu9mNJ5"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from buildingmotif import BuildingMOTIF\nfrom buildingmotif.dataclasses import Library, Model\nimport logging\nimport os\n\n# Create a BuildingMOTIF object. This validates with the \"pyshifty\" SHACL engine by default\nbm = BuildingMOTIF('sqlite://', log_level=logging.ERROR)\n\n# load 223P library. We will load a recent copy from the models.open223.info\n# git repository; later, we will load this from the location of the actual standard.\n# BuildingMOTIF uses OntoEnv to fetch the ontologies 223P depends on (QUDT, SHACL, ...).\ns223 = Library.from_ontology(\"https://open223.info/223p.ttl\", infer_templates=False, run_shacl_inference=False)\n\n# Load the published model by default. Local development can override this so\n# a page build validates edits that have not been deployed yet.\nmodel_location = os.environ.get(\n    \"OPEN223_MODEL_PATH\", \"https://models.open223.info/guideline36-2021-A-7.ttl\"\n)\nmodel = Model.from_file(model_location)\n\n# a model's manifest lists the libraries it should conform to\nmodel.manifest.add(s223)\n\n# validate the model against its manifest\nctx = model.validate()\n\n# print the validation result\nprint(f\"Model is valid: {ctx.valid}\")\n\n# if the model is invalid, print the validation report\nif not ctx.valid:\n    print(ctx.report_string[:1000]) # first 1000 characters of the report\n\n# BuildingMOTIF can also interpret the report to provide recommendations on fixes\nfor focus_node, diffs in ctx.get_reasons_with_severity(\"Violation\").items():\n    if len(diffs) == 0:\n        continue\n    print(focus_node)\n    for diff in diffs:\n        print(\"  - \" + diff.reason())\n\n# Production builds continue to render pages for historical invalid models.\n# The single-model development target opts into treating invalidity as an\n# execution error so its exit status can be used as a test result.\nif not ctx.valid and os.environ.get(\"OPEN223_FAIL_ON_INVALID\"):\n    raise RuntimeError(\"Model validation failed\")","key":"nizFmOJa8g"},{"type":"outputs","id":"PdTehMFHZpsGHGhNu1azQ","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Model is valid: True\n"},"key":"XdoVMFZ1Zq"}],"key":"Rm8MYz1dB5"}],"key":"NqIEKyCGkD"}],"key":"Z8RGtolw2A"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"ASHRAE Guideline 36-2021 A-4 Parallel Fan-Powered Terminal Unit, Variable Volume Fan","url":"/guideline36-2021-a-4","group":"Example Systems"},"next":{"title":"ASHRAE Guideline 36-2021 A-8 Dual Duct Terminal Unit with Discharge Sensor","url":"/guideline36-2021-a-8","group":"Example Systems"}}},"domain":"http://localhost:3000"}