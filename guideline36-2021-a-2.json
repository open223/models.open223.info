ue,"key":"XD28Fkduyv"},{"type":"paragraph","position":{"start":{"line":71,"column":1},"end":{"line":72,"column":1}},"children":[{"type":"text","value":"This code uses the ","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"FarkQIskaR"},{"type":"link","url":"https://github.com/NREL/BuildingMOTIF","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"text","value":"BuildingMOTIF","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"RPGwqQ8K0f"}],"urlSource":"https://github.com/NREL/BuildingMOTIF","error":true,"key":"abStFPz75L"},{"type":"text","value":" library to load the 223P ontology and the model file into a temporary in-memory instance.\nIt then validates the model against the ontology. If the model is invalid, it will print the validation report.","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"ZxuTUmiuqW"}],"key":"a1riMA7jKC"},{"type":"paragraph","position":{"start":{"line":74,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"BuildingMOTIF resolves the ontology’s dependencies with ","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"key":"m7ZKwjk1JE"},{"type":"link","url":"https://ontoenv.gtf.fyi","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"children":[{"type":"text","value":"OntoEnv","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"key":"KS6WLMS7Xg"}],"urlSource":"https://ontoenv.gtf.fyi","key":"Gu1ibzdrNm"},{"type":"text","value":" and validates with\n","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"key":"WKSIJ5K5qx"},{"type":"link","url":"https://shifty.gtf.fyi","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"children":[{"type":"text","value":"shifty","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"key":"QpWunVL9Id"}],"urlSource":"https://shifty.gtf.fyi","key":"VNneeVf1gO"},{"type":"text","value":", both of which are self-contained Rust extensions, so there is nothing else to install and no Java is required.","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"key":"DP0hAJE08l"}],"key":"aGPIBQtEPf"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"BuildingMOTIF installation","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"sdXUKvtEQC"}],"key":"VK6qoxWd4J"},{"type":"paragraph","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"text","value":"To install the ","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"U9jRMtps9v"},{"type":"inlineCode","value":"buildingmotif","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"Ee0pgFBiPu"},{"type":"text","value":" library, you can use the following command:","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"hGD0vS4Esk"}],"key":"DVpkBVVBDf"},{"type":"code","lang":"shell","value":"pip install 'buildingmotif @ git+https://github.com/NREL/buildingmotif.git@gtf-buildingmotif'","position":{"start":{"line":81,"column":1},"end":{"line":83,"column":1}},"key":"OnnElQAcP0"}],"class":"dropdown","key":"Y81Sbs4O7l"}],"key":"HDFBSLHEsF"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from buildingmotif import BuildingMOTIF\nfrom buildingmotif.dataclasses import Library, Model\nimport logging\n\n# Create a BuildingMOTIF object. This validates with the \"pyshifty\" SHACL\n# engine by default, so there is nothing else to install and no Java required.\nbm = BuildingMOTIF('sqlite://', log_level=logging.ERROR)\n\n# load 223P library. We will load a recent copy from the models.open223.info\n# git repository; later, we will load this from the location of the actual standard.\n# BuildingMOTIF uses OntoEnv to fetch the ontologies 223P depends on (QUDT, SHACL, ...).\ns223 = Library.from_ontology(\"https://open223.info/223p.ttl\", infer_templates=False, run_shacl_inference=False)\n\n# load the model into the BuildingMOTIF instance\nmodel = Model.from_file(\"https://models.open223.info/guideline36-2021-A-2.ttl\")\n\n# a model's manifest lists the libraries it should conform to\nmodel.manifest.add(s223)\n\n# validate the model against its manifest\nctx = model.validate()\n\n# print the validation result\nprint(f\"Model is valid: {ctx.valid}\")\n\n# if the model is invalid, print the validation report\nif not ctx.valid:\n    print(ctx.report_string[:1000]) # first 1000 characters of the report\n\n# BuildingMOTIF can also interpret the report to provide recommendations on fixes\nfor focus_node, diffs in ctx.get_reasons_with_severity(\"Violation\").items():\n    if len(diffs) == 0:\n        continue\n    print(focus_node)\n    for diff in diffs:\n        print(\"  - \" + diff.reason())","key":"OmcLuIBD98"},{"type":"outputs","id":"0UCDoA3MLdM4Oz92Dhxxq","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Model is valid: True\n"},"key":"l5ApKqDm1k"}],"key":"xo8ePOeeQc"}],"key":"mNYDFNb48i"}],"key":"c2uSfDo8aE"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"ASHRAE Guideline 36-2021 A-1 VAV Terminal Unit, Cooling Only","url":"/guideline36-2021-a-1","group":"Example Systems"},"next":{"title":"ASHRAE Guideline 36-2021 A-3 Parallel Fan-Powered Terminal Unit, Constant Volume Fan","url":"/guideline36-2021-a-3","group":"Example Systems"}}},"domain":"http://localhost:3000"}