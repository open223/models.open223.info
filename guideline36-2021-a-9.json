ition":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"text","value":"OntoEnv","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"BBAX5oZdPm"}],"urlSource":"https://ontoenv.gtf.fyi","key":"O5bq9POhV0"},{"type":"text","value":" and validates with\n","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"k3JDuQTmwH"},{"type":"link","url":"https://shifty.gtf.fyi","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"text","value":"shifty","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"BB4zCzNudK"}],"urlSource":"https://shifty.gtf.fyi","key":"ThcCpRofwT"},{"type":"text","value":", both of which are self-contained Rust extensions, so there is nothing else to install and no Java is required.","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"Gn3SfW7ttr"}],"key":"orlrJqlmGt"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"BuildingMOTIF installation","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"FLgScWigUm"}],"key":"nEZNWR0TAF"},{"type":"paragraph","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"To install the ","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"EFFLtlhxjk"},{"type":"inlineCode","value":"buildingmotif","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"LPXZeEqgDc"},{"type":"text","value":" library, you can use the following command:","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"PI7UlZpTfW"}],"key":"ohkwumxuQq"},{"type":"code","lang":"shell","value":"pip install 'buildingmotif @ git+https://github.com/NREL/buildingmotif.git@gtf-buildingmotif'","position":{"start":{"line":83,"column":1},"end":{"line":85,"column":1}},"key":"HsLiBRdXWS"}],"class":"dropdown","key":"kHDq9tJZRB"}],"key":"gNbPYnW5AS"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from buildingmotif import BuildingMOTIF\nfrom buildingmotif.dataclasses import Library, Model\nfrom datetime import datetime, timezone\nimport logging\n\n# Create a BuildingMOTIF object. This validates with the \"pyshifty\" SHACL\n# engine by default, so there is nothing else to install and no Java required.\nbm = BuildingMOTIF('sqlite://', log_level=logging.ERROR)\n\n# load 223P library. We will load a recent copy from the models.open223.info\n# git repository; later, we will load this from the location of the actual standard.\n# BuildingMOTIF uses OntoEnv to fetch the ontologies 223P depends on (QUDT, SHACL, ...).\ns223 = Library.from_ontology(\"https://open223.info/223p.ttl\", infer_templates=False, run_shacl_inference=False)\n\n# load the model into the BuildingMOTIF instance. This page pins the exact copy\n# it was built and validated against, so it stays reproducible as the site moves\n# on. To run this against the current published model, use the permanent URL:\n#\n#     model = Model.from_file(\"https://models.open223.info/guideline36-2021-A-9.ttl\")\n#\nmodel = Model.from_file(\"https://raw.githubusercontent.com/open223/models.open223.info/48c95b6c8575654872eb37abb7dca40cd50636ab/models/guideline36-2021-A-9.ttl\")\n\n# a model's manifest lists the libraries it should conform to\nmodel.manifest.add(s223)\n\n# validate the model against its manifest\nctx = model.validate()\n\n# print when validation completed\nprint(f\"Validation run at: {datetime.now(timezone.utc).isoformat(timespec='seconds')}\")\n\n# print the validation result\nprint(f\"Model is valid: {ctx.valid}\")\n\n# if the model is invalid, print the validation report\nif not ctx.valid:\n    print(ctx.report_string[:1000]) # first 1000 characters of the report\n\n# BuildingMOTIF can also interpret the report to provide recommendations on fixes\nfor focus_node, diffs in ctx.get_reasons_with_severity(\"Violation\").items():\n    if len(diffs) == 0:\n        continue\n    print(focus_node)\n    for diff in diffs:\n        print(\"  - \" + diff.reason())","key":"RBr3CNSo1m"},{"type":"code","lang":"text","value":"Validation run at: 2026-09-21T16:24:50+00:00\nModel is valid: True\n","class":"validation-output","key":"zLITjBU9QF"}],"key":"Jvul4exc1L"}],"key":"jqAmtWSien"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"ASHRAE Guideline 36-2021 A-8 Dual Duct Terminal Unit with Discharge Sensor","url":"/guideline36-2021-a-8","group":"Example Systems"},"next":{"title":"ASHRAE Guideline 36-2021 A-11 Dual Fan, Dual Duct Air Handling Unit, Heating","url":"/guideline36-2021-a-11","group":"Example Systems"}}},"domain":"http://localhost:3000"}