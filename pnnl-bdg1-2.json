\nIt then validates the model against the ontology. If the model is invalid, it will print the validation report.","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"key":"R8FFMTqIXq"}],"key":"nc4g4PNxXh"},{"type":"paragraph","position":{"start":{"line":107,"column":1},"end":{"line":108,"column":1}},"children":[{"type":"text","value":"BuildingMOTIF resolves the ontology’s dependencies with ","position":{"start":{"line":107,"column":1},"end":{"line":107,"column":1}},"key":"zmpFcf4dge"},{"type":"link","url":"https://ontoenv.gtf.fyi","position":{"start":{"line":107,"column":1},"end":{"line":107,"column":1}},"children":[{"type":"text","value":"OntoEnv","position":{"start":{"line":107,"column":1},"end":{"line":107,"column":1}},"key":"P2unBQ1c8I"}],"urlSource":"https://ontoenv.gtf.fyi","key":"tAXO29aAT7"},{"type":"text","value":" and validates with\n","position":{"start":{"line":107,"column":1},"end":{"line":107,"column":1}},"key":"Y7zYkQRgmc"},{"type":"link","url":"https://shifty.gtf.fyi","position":{"start":{"line":107,"column":1},"end":{"line":107,"column":1}},"children":[{"type":"text","value":"shifty","position":{"start":{"line":107,"column":1},"end":{"line":107,"column":1}},"key":"RLHWBi3BTT"}],"urlSource":"https://shifty.gtf.fyi","key":"eIdHOM8kvW"},{"type":"text","value":", both of which are self-contained Rust extensions, so there is nothing else to install and no Java is required.","position":{"start":{"line":107,"column":1},"end":{"line":107,"column":1}},"key":"lfAh0kJ58c"}],"key":"OMsjGoxmQX"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"BuildingMOTIF installation","position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"key":"TQcj3siobK"}],"key":"Uon9JMscNd"},{"type":"paragraph","position":{"start":{"line":112,"column":1},"end":{"line":112,"column":1}},"children":[{"type":"text","value":"To install the ","position":{"start":{"line":112,"column":1},"end":{"line":112,"column":1}},"key":"hqj7xEkaOj"},{"type":"inlineCode","value":"buildingmotif","position":{"start":{"line":112,"column":1},"end":{"line":112,"column":1}},"key":"e8aBXaa5p2"},{"type":"text","value":" library, you can use the following command:","position":{"start":{"line":112,"column":1},"end":{"line":112,"column":1}},"key":"ZpWVJZAW5n"}],"key":"ohlCxx9O6m"},{"type":"code","lang":"shell","value":"pip install 'buildingmotif @ git+https://github.com/NREL/buildingmotif.git@gtf-buildingmotif'","position":{"start":{"line":114,"column":1},"end":{"line":116,"column":1}},"key":"bmbdZfX1US"}],"class":"dropdown","key":"P4rPILTdkt"}],"key":"tWuwqBRUiU"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from buildingmotif import BuildingMOTIF\nfrom buildingmotif.dataclasses import Library, Model\nimport logging\n\n# Create a BuildingMOTIF object. This validates with the \"pyshifty\" SHACL\n# engine by default, so there is nothing else to install and no Java required.\nbm = BuildingMOTIF('sqlite://', log_level=logging.ERROR)\n\n# load 223P library. We will load a recent copy from the models.open223.info\n# git repository; later, we will load this from the location of the actual standard.\n# BuildingMOTIF uses OntoEnv to fetch the ontologies 223P depends on (QUDT, SHACL, ...).\ns223 = Library.from_ontology(\"https://open223.info/223p.ttl\", infer_templates=False, run_shacl_inference=False)\n\n# load the model into the BuildingMOTIF instance\nmodel = Model.from_file(\"https://models.open223.info/pnnl-bdg1-2.ttl\")\n\n# a model's manifest lists the libraries it should conform to\nmodel.manifest.add(s223)\n\n# validate the model against its manifest\nctx = model.validate()\n\n# print the validation result\nprint(f\"Model is valid: {ctx.valid}\")\n\n# if the model is invalid, print the validation report\nif not ctx.valid:\n    print(ctx.report_string[:1000]) # first 1000 characters of the report\n\n# BuildingMOTIF can also interpret the report to provide recommendations on fixes\nfor focus_node, diffs in ctx.get_reasons_with_severity(\"Violation\").items():\n    if len(diffs) == 0:\n        continue\n    print(focus_node)\n    for diff in diffs:\n        print(\"  - \" + diff.reason())","key":"FohOCaM80R"},{"type":"outputs","id":"6syc4f51Vo976o_c5yl3m","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Model is valid: False\nValidation Report\nConforms: False\n\nViolation result in http://data.ashrae.org/standard223#Equipment (<http://speckle.xyz/streams/59e5e3c6a8/objects/0afb7c8e9477410024492f1cf1a1cbd4>):\n  Path: <http://data.ashrae.org/standard223#hasPhysicalLocation>\n  Severity: Violation\n  Value: <http://speckle.xyz/streams/59e5e3c6a8/objects/8aa694885f0bc783d007c24a0a81c3b4>\n  Message: must be an instance of <http://data.ashrae.org/standard223#PhysicalSpace>\n\nViolation result in http://data.ashrae.org/standard223#ConnectionPoint (<http://speckle.xyz/streams/59e5e3c6a8/objects/11c04c42e073d0d0b9c2a00aadf4901b>):\n  Path: <http://data.ashrae.org/standard223#isConnectionPointOf>\n  Severity: Violation\n  Value: <http://speckle.xyz/streams/59e5e3c6a8/objects/11c04c42e073d0d0b9c2a00aadf4901b>\n  Message: at least 1 value(s) required along <http://data.ashrae.org/standard223#isConnectionPointOf>, found 0\n\nViolation result in http://data.ashrae.org/standard223#Equipment (<http://speckle.xyz/streams/59e5e3c6a8/obj\nhttp://speckle.xyz/streams/59e5e3c6a8/objects/0afb7c8e9477410024492f1cf1a1cbd4\n  - <http://speckle.xyz/streams/59e5e3c6a8/objects/8aa694885f0bc783d007c24a0a81c3b4> must be an instance of <http://data.ashrae.org/standard223#PhysicalSpace>\nhttp://speckle.xyz/streams/59e5e3c6a8/objects/11c04c42e073d0d0b9c2a00aadf4901b\n  - <http://speckle.xyz/streams/59e5e3c6a8/objects/11c04c42e073d0d0b9c2a00aadf4901b> at least 1 value(s) required along <http://data.ashrae.org/standard223#isConnectionPointOf>, found 0\nht