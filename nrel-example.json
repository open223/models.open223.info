{"type":"text","value":"Load and Validate Model","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"DCQTk1nqQM"}],"identifier":"load-and-validate-model","label":"Load and Validate Model","html_id":"load-and-validate-model","implicit":true,"key":"itZ4yovkFb"},{"type":"paragraph","position":{"start":{"line":70,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"text","value":"This code uses the ","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"ZEYBE1T732"},{"type":"link","url":"https://github.com/NREL/BuildingMOTIF","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"text","value":"BuildingMOTIF","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"tJrcw6R2Cr"}],"urlSource":"https://github.com/NREL/BuildingMOTIF","error":true,"key":"MRaQibecZS"},{"type":"text","value":" library to load the 223P ontology and the model file into a temporary in-memory instance.\nIt then validates the model against the ontology. If the model is invalid, it will print the validation report.","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"ts93Ois4Dh"}],"key":"MHf83iBn3D"},{"type":"paragraph","position":{"start":{"line":73,"column":1},"end":{"line":74,"column":1}},"children":[{"type":"text","value":"BuildingMOTIF resolves the ontology’s dependencies with ","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"EiInZBkrbd"},{"type":"link","url":"https://ontoenv.gtf.fyi","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"text","value":"OntoEnv","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"eTrSN8XawI"}],"urlSource":"https://ontoenv.gtf.fyi","key":"qAMY2WbmJg"},{"type":"text","value":" and validates with\n","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"Dz165ktpNJ"},{"type":"link","url":"https://shifty.gtf.fyi","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"text","value":"shifty","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"tDG0LVcoRA"}],"urlSource":"https://shifty.gtf.fyi","key":"TdV9uuRHD2"},{"type":"text","value":", both of which are self-contained Rust extensions, so there is nothing else to install and no Java is required.","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"JmTDQBUfEP"}],"key":"iCErvYCN8T"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"BuildingMOTIF installation","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"hcTNfJbop7"}],"key":"bwnK9uzDlV"},{"type":"paragraph","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"children":[{"type":"text","value":"To install the ","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"ZTlK2qnwBY"},{"type":"inlineCode","value":"buildingmotif","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"kLhhySXzgB"},{"type":"text","value":" library, you can use the following command:","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"dYF4ZmwhB9"}],"key":"QVMTilTWQT"},{"type":"code","lang":"shell","value":"pip install 'buildingmotif @ git+https://github.com/NREL/buildingmotif.git@gtf-buildingmotif'","position":{"start":{"line":80,"column":1},"end":{"line":82,"column":1}},"key":"ziO6RrkxkO"}],"class":"dropdown","key":"pmNCjwZX3z"}],"key":"cq8HImOTUY"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from buildingmotif import BuildingMOTIF\nfrom buildingmotif.dataclasses import Library, Model\nfrom datetime import datetime, timezone\nimport logging\n\n# Create a BuildingMOTIF object. This validates with the \"pyshifty\" SHACL\n# engine by default, so there is nothing else to install and no Java required.\nbm = BuildingMOTIF('sqlite://', log_level=logging.ERROR)\n\n# load 223P library. We will load a recent copy from the models.open223.info\n# git repository; later, we will load this from the location of the actual standard.\n# BuildingMOTIF uses OntoEnv to fetch the ontologies 223P depends on (QUDT, SHACL, ...).\ns223 = Library.from_ontology(\"https://open223.info/223p.ttl\", infer_templates=False, run_shacl_inference=False)\n\n# load the model into the BuildingMOTIF instance. This page pins the exact copy\n# it was built and validated against, so it stays reproducible as the site moves\n# on. To run this against the current published model, use the permanent URL:\n#\n#     model = Model.from_file(\"https://models.open223.info/nrel-example.ttl\")\n#\nmodel = Model.from_file(\"https://raw.githubusercontent.com/open223/models.open223.info/48c95b6c8575654872eb37abb7dca40cd50636ab/models/nrel-example.ttl\")\n\n# a model's manifest lists the libraries it should conform to\nmodel.manifest.add(s223)\n\n# validate the model against its manifest\nctx = model.validate()\n\n# print when validation completed\nprint(f\"Validation run at: {datetime.now(timezone.utc).isoformat(timespec='seconds')}\")\n\n# print the validation result\nprint(f\"Model is valid: {ctx.valid}\")\n\n# if the model is invalid, print the validation report\nif not ctx.valid:\n    print(ctx.report_string[:1000]) # first 1000 characters of the report\n\n# BuildingMOTIF can also interpret the report to provide recommendations on fixes\nfor focus_node, diffs in ctx.get_reasons_with_severity(\"Violation\").items():\n    if len(diffs) == 0:\n        continue\n    print(focus_node)\n    for diff in diffs:\n        print(\"  - \" + diff.reason())","key":"szcg9jXkpg"},{"type":"code","lang":"text","value":"Validation run at: 2026-09-21T16:20:49+00:00\nModel is valid: True\n","class":"validation-output","key":"Ahen9sbEeW"}],"key":"Oj4FrEFnp3"}],"key":"LX9YPDn36j"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"LBNL Example Building 4 Model 1","url":"/lbnl-bdg4-1","group":"Example Buildings"},"next":{"title":"Heat Pump Laboratory (HPL)","url":"/nist-hpl","group":"Example Buildings"}}},"domain":"http://localhost:3000"}