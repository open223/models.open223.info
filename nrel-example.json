ad and Validate Model","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"DLSJDhGO1F"}],"identifier":"load-and-validate-model","label":"Load and Validate Model","html_id":"load-and-validate-model","implicit":true,"key":"OjG93Ae5iw"},{"type":"paragraph","position":{"start":{"line":78,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"text","value":"This code uses the ","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"jTVWzlqodB"},{"type":"link","url":"https://github.com/NREL/BuildingMOTIF","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"children":[{"type":"text","value":"BuildingMOTIF","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"TucNz8pcqU"}],"urlSource":"https://github.com/NREL/BuildingMOTIF","error":true,"key":"xSiV5XHTCP"},{"type":"text","value":" library to load the 223P ontology and the model file into a temporary in-memory instance.\nIt then validates the model against the ontology. If the model is invalid, it will print the validation report.","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"vUdrDq0wpo"}],"key":"cmh8LW1KdJ"},{"type":"paragraph","position":{"start":{"line":81,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"text","value":"BuildingMOTIF resolves the ontology’s dependencies with ","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"GeGYFJPc2n"},{"type":"link","url":"https://ontoenv.gtf.fyi","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"OntoEnv","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"xt5KN2AAJk"}],"urlSource":"https://ontoenv.gtf.fyi","key":"SByJ8VQfLU"},{"type":"text","value":" and validates with\n","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"zE7oGF4Vjn"},{"type":"link","url":"https://shifty.gtf.fyi","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"shifty","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"Ft9GGDkX7a"}],"urlSource":"https://shifty.gtf.fyi","key":"rQbweXzsla"},{"type":"text","value":", both of which are self-contained Rust extensions, so there is nothing else to install and no Java is required.","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"cVK35jegqJ"}],"key":"k6yYtBapjE"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"BuildingMOTIF installation","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"mW2Qafx73G"}],"key":"ix6MVW8rre"},{"type":"paragraph","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"text","value":"To install the ","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"tYnhJCJU0n"},{"type":"inlineCode","value":"buildingmotif","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"W1Nit9c8Hm"},{"type":"text","value":" library, you can use the following command:","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"tbk0EUEKua"}],"key":"p7ZACapO1K"},{"type":"code","lang":"shell","value":"pip install 'buildingmotif @ git+https://github.com/NREL/buildingmotif.git@gtf-buildingmotif'","position":{"start":{"line":88,"column":1},"end":{"line":90,"column":1}},"key":"wmoMLmDSFm"}],"class":"dropdown","key":"ZsQQ3dxtRg"}],"key":"t4mnHneKeQ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from buildingmotif import BuildingMOTIF\nfrom buildingmotif.dataclasses import Library, Model\nimport logging\n\n# Create a BuildingMOTIF object. This validates with the \"pyshifty\" SHACL\n# engine by default, so there is nothing else to install and no Java required.\nbm = BuildingMOTIF('sqlite://', log_level=logging.ERROR)\n\n# load 223P library. We will load a recent copy from the models.open223.info\n# git repository; later, we will load this from the location of the actual standard.\n# BuildingMOTIF uses OntoEnv to fetch the ontologies 223P depends on (QUDT, SHACL, ...).\ns223 = Library.from_ontology(\"https://open223.info/223p.ttl\", infer_templates=False, run_shacl_inference=False)\n\n# load the model into the BuildingMOTIF instance\nmodel = Model.from_file(\"https://models.open223.info/nrel-example.ttl\")\n\n# a model's manifest lists the libraries it should conform to\nmodel.manifest.add(s223)\n\n# validate the model against its manifest\nctx = model.validate()\n\n# print the validation result\nprint(f\"Model is valid: {ctx.valid}\")\n\n# if the model is invalid, print the validation report\nif not ctx.valid:\n    print(ctx.report_string[:1000]) # first 1000 characters of the report\n\n# BuildingMOTIF can also interpret the report to provide recommendations on fixes\nfor focus_node, diffs in ctx.get_reasons_with_severity(\"Violation\").items():\n    if len(diffs) == 0:\n        continue\n    print(focus_node)\n    for diff in diffs:\n        print(\"  - \" + diff.reason())","key":"MomsPlf3gc"},{"type":"outputs","id":"zNB04-TD9C7kla3lWRVbX","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Model is valid: True\n"},"key":"HTWZDtMr4s"}],"key":"qEdTfTnSJA"}],"key":"F3ldM7Dlj3"}],"key":"ATM9YdLyzV"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"LBNL Example Building 4 Model 1","url":"/lbnl-bdg4-1","group":"Example Buildings"},"next":{"title":"Heat Pump Laboratory (HPL)","url":"/nist-hpl","group":"Example Buildings"}}},"domain":"http://localhost:3000"}