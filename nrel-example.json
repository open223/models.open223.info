ad and Validate Model","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"JHEIY8mdvE"}],"identifier":"load-and-validate-model","label":"Load and Validate Model","html_id":"load-and-validate-model","implicit":true,"key":"axLMYkbVTj"},{"type":"paragraph","position":{"start":{"line":78,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"text","value":"This code uses the ","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"WY6mp9HfID"},{"type":"link","url":"https://github.com/NREL/BuildingMOTIF","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"children":[{"type":"text","value":"BuildingMOTIF","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"tOimQUmqWP"}],"urlSource":"https://github.com/NREL/BuildingMOTIF","error":true,"key":"JKdCmOw1Eh"},{"type":"text","value":" library to load the 223P ontology and the model file into a temporary in-memory instance.\nIt then validates the model against the ontology. If the model is invalid, it will print the validation report.","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"xNoJkeF1D1"}],"key":"fUOiBELmeW"},{"type":"paragraph","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"BuildingMOTIF resolves the ontology’s dependencies and performs SHACL validation and inference","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"VNGkJP9Abs"}],"key":"S9JSfG1sHq"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"BuildingMOTIF installation","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"bb53IihM8z"}],"key":"LP4xV8YIRc"},{"type":"paragraph","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"text","value":"To install the ","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"vP0o8oPtLd"},{"type":"inlineCode","value":"buildingmotif","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"TEwyDu4ZhG"},{"type":"text","value":" library, you can use the following command:","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"zmlTqciTfQ"}],"key":"LHtgbsot2w"},{"type":"code","lang":"shell","value":"pip install 'buildingmotif @ git+https://github.com/NREL/buildingmotif.git@gtf-buildingmotif'","position":{"start":{"line":87,"column":1},"end":{"line":89,"column":1}},"key":"CPUje3Uk1H"}],"class":"dropdown","key":"ip8QSjqbKN"}],"key":"pZUQwf2y8r"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from buildingmotif import BuildingMOTIF\nfrom buildingmotif.dataclasses import Library, Model\nimport logging\n\n# Create a BuildingMOTIF object. This validates with the \"pyshifty\" SHACL engine by default\nbm = BuildingMOTIF('sqlite://', log_level=logging.ERROR)\n\n# load 223P library. We will load a recent copy from the models.open223.info\n# git repository; later, we will load this from the location of the actual standard.\n# BuildingMOTIF uses OntoEnv to fetch the ontologies 223P depends on (QUDT, SHACL, ...).\ns223 = Library.from_ontology(\"https://open223.info/223p.ttl\", infer_templates=False, run_shacl_inference=False)\n\n# load the model into the BuildingMOTIF instance\nmodel = Model.from_file(\"https://models.open223.info/nrel-example.ttl\")\n\n# a model's manifest lists the libraries it should conform to\nmodel.manifest.add(s223)\n\n# validate the model against its manifest\nctx = model.validate()\n\n# print the validation result\nprint(f\"Model is valid: {ctx.valid}\")\n\n# if the model is invalid, print the validation report\nif not ctx.valid:\n    print(ctx.report_string[:1000]) # first 1000 characters of the report\n\n# BuildingMOTIF can also interpret the report to provide recommendations on fixes\nfor focus_node, diffs in ctx.get_reasons_with_severity(\"Violation\").items():\n    if len(diffs) == 0:\n        continue\n    print(focus_node)\n    for diff in diffs:\n        print(\"  - \" + diff.reason())","key":"v4G7i0Rkjc"},{"type":"outputs","id":"OZ9Xh-0kOajihsELHV8Af","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Model is valid: True\n"},"key":"MONcb8hg48"}],"key":"pcDho6b9TZ"}],"key":"FZ9KkeOK87"}],"key":"prdlTVZILB"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"LBNL Example Building 4 Model 1","url":"/lbnl-bdg4-1","group":"Example Buildings"},"next":{"title":"Heat Pump Laboratory (HPL)","url":"/nist-hpl","group":"Example Buildings"}}},"domain":"http://localhost:3000"}