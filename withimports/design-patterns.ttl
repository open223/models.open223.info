    ns1:symbol "S" ;
    ns1:wikidataMatch <http://www.wikidata.org/entity/Q98915762> ;
    rdfs:comment "Applicable units are those of quantitykind:ParticleSourceDensity" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/vocab/quantitykind> .

