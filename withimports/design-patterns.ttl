        "https://en.wikipedia.org/wiki/Fathom?oldid=493265429"^^xsd:anyURI ;
    ns1:scalingOf <http://qudt.org/vocab/unit/M> ;
    ns1:symbol "fathom" ;
    ns1:ucumCode "[fth_i]"^^ns1:UCUMcs ;
    ns1:uneceCommonCode "AK" ;
    ns1:wikidataMatch <http://www.wikidata.org/entity/Q6502423> ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/vocab/unit> .

