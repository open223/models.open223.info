<http://qudt.org/vocab/unit/NCM> a ns1:Unit ;
    rdfs:label "Normal Cubic Metre",
        "Normkubikmeter"@de,
        "Normal Cubic Metre"@en,
        "Normal Cubic Meter"@en-us ;
    dcterms:description """
The $\\textit{normal cubic metre}$ is a unit representing the amount of a product contained in a volume of one cubic metre at reference 'normal' temperature and pressure conditions. As such, it is a measure of the actual amount of product, most commonly referring to oil, not the volume of the product. The reference conditions for normal cubic metre vary depending on purpose and application.
  """^^ns1:LatexString ;
    ns1:conversionMultiplier 0.0 ;
    ns1:conversionMultiplierSN 0e+00 ;
    ns1:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A1E0L0I0M0H0T0D0> ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/AmountOfSubstance> ;
    ns1:informativeReference "https://www.wikidata.org/entity/Q350023"^^xsd:anyURI ;
    ns1:scalingOf <http://qudt.org/vocab/unit/MOL> ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/vocab/unit> ;
    rdfs:seeAlso <http://qudt.org/vocab/unit/SCM> .

