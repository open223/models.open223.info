    ns1:conversionMultiplierSN 2.551443e+06 ;
    ns1:dbpediaMatch "http://dbpedia.org/resource/Month"^^xsd:anyURI ;
    ns1:exactMatch <http://qudt.org/vocab/unit/MO_Synodic> ;
