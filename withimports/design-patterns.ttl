            ns1:hasUnit <http://qudt.org/vocab/unit/BTU_IT> ],
        [ a ns1:FactorUnit ;
            ns1:exponent -1 ;
            ns1:hasUnit <http://qudt.org/vocab/unit/DEG_F> ] ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/HeatCapacity> ;
    ns1:iec61360Code "0112/2///62720#UAB271" ;
