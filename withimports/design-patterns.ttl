<http://qudt.org/vocab/unit/PicoCI> a ns1:Unit ;
    rdfs:label "Picocurie",
        "Picocurie"@en ;
    dcterms:description "The picocurie (pCi) is $10^{-12}$ of the curie, a non-SI unit of radioactivity. $1\\,\\text{pCi} = 3.7 \\times 10^{-2}\\,\\text{Bq} = 0.037$ radioactive disintegrations per second. It is commonly used in environmental monitoring, particularly for radon activity in air and water."^^ns1:LatexString ;
    ns1:applicableSystem <http://qudt.org/vocab/sou/CGS> ;
    ns1:conversionMultiplier 0.037 ;
