    ns1:udunitsCode "Pa" ;
    ns1:uneceCommonCode "PAL" ;
    ns1:wikidataMatch <http://www.wikidata.org/entity/Q44395> ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/vocab/unit> .

