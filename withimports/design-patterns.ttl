    ns1:informativeReference "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB210"^^xsd:anyURI,
        "https://en.wikipedia.org/wiki/Abampere"^^xsd:anyURI,
        "https://en.wikipedia.org/wiki/Biot?oldid=443318821"^^xsd:anyURI ;
    ns1:omUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/biot> ;
