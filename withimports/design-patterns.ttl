s223:GlycolSolution-15Percent a s223:Class,
        s223:GlycolSolution-15Percent,
        sh:NodeShape ;
    rdfs:label "15 percent glycol solution" ;
    s223:composedOf [ a s223:QuantifiableProperty ;
