    ns1:conversionMultiplier 0.000000000001 ;
    ns1:conversionMultiplierSN 1e-12 ;
    ns1:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-3D0> ;
