    rdfs:comment "Applicable units are those of quantitykind:BiodegredationHalfLife" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/vocab/quantitykind> ;
    skos:broader <http://qudt.org/vocab/quantitykind/Time> .

