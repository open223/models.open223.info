    ns1:symbol "G" ;
    ns1:wikidataMatch <http://www.wikidata.org/entity/Q105475278> ;
    rdfs:comment "Applicable units are those of quantitykind:AngularReciprocalLatticeVector" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/vocab/quantitykind> .

