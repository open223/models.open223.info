    ns1:derivedUnitOfSystem <http://qudt.org/vocab/sou/PLANCK> ;
    ns1:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H0T-2D0> ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/Force> ;
