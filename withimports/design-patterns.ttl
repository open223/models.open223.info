            ns1:exponent -1 ;
            ns1:hasUnit <http://qudt.org/vocab/unit/GM> ] ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/SpecificElectricCharge> ;
    ns1:symbol "mA·h/g" ;
    ns1:ucumCode "mA.h.g-1"^^ns1:UCUMcs ;
