            ns1:exponent -1 ;
            ns1:hasUnit <http://qudt.org/vocab/unit/L> ] ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/PlasmaLevel>,
        <http://qudt.org/vocab/quantitykind/SerumLevel> ;
    ns1:symbol "IU/L" ;
    ns1:ucumCode "[IU].L-1"^^ns1:UCUMcs ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/vocab/unit> ;
    rdfs:seeAlso <http://qudt.org/vocab/unit/IU> .

