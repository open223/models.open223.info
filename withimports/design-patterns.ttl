    sh:datatype xsd:integer ;
    sh:path sh:maxListLength .

sh:MemberShapeConstraintComponent-memberShape a sh:Parameter ;
    rdfs:isDefinedBy sh: ;
    sh:node sh:NodeShape ;
    sh:path sh:memberShape .

sh:MinCountConstraintComponent-minCount a sh:Parameter ;
    rdfs:isDefinedBy sh: ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:path sh:minCount .

sh:MinExclusiveConstraintComponent-minExclusive a sh:Parameter ;
    rdfs:isDefinedBy sh: ;
    sh:maxCount 1 ;
