    ns1:informativeReference "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA235"^^xsd:anyURI,
        "https://en.wikipedia.org/wiki/Newton?oldid=488427661"^^xsd:anyURI ;
