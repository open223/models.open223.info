<http://qudt.org/vocab/unit/NT> a ns1:Unit ;
    rdfs:label "Net Tonnage",
        "Net Tonnage"@en ;
    ns1:applicableSystem <http://qudt.org/vocab/sou/USCS> ;
    ns1:conversionMultiplier 0.0 ;
    ns1:conversionMultiplierSN 0e+00 ;
