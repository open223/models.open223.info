        "napięcie elektryczne"@pl,
        "tensão elétrica (diferença de potencial)"@pt,
        "diferență de potențial electric"@ro,
        "электрическое напряжение"@ru,
        "električna napetost"@sl,
        "gerilim"@tr,
        "電壓"@zh ;
