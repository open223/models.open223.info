    s223:hasConnectionPoint pt8:JunctionInletCP,
        pt8:JunctionOutletCP1,
        pt8:JunctionOutletCP2,
        pt8:JunctionOutletCP3 ;
    s223:hasMedium s223:AC-120VLN-1Ph-60Hz .

