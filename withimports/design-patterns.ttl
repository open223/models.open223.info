    dcterms:description """The SI derived unit for speed is the meter/second.
1 meter/second is equal to 0.0323974082073 nautical mile per minute. """^^rdf:HTML ;
    ns1:applicableSystem <http://qudt.org/vocab/sou/USCS> ;
