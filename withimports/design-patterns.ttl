            ns1:exponent -1 ;
            ns1:hasUnit <http://qudt.org/vocab/unit/HA> ] ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/MassPerArea> ;
    ns1:symbol "g/ha" ;
    ns1:ucumCode "g.har-1"^^ns1:UCUMcs ;
