    ns1:scalingOf <http://qudt.org/vocab/unit/N> ;
    ns1:symbol "planckforce" ;
    ns1:wikidataMatch <http://www.wikidata.org/entity/Q915169> ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/vocab/unit> .

