    rdfs:label "field type" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/datatype> ;
    rdfs:subPropertyOf ns1:elementDatatype .

ns1:figureCaption a rdf:Property ;
    rdfs:label "figure caption" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/qudt> .

ns1:figureLabel a rdf:Property ;
    rdfs:label "figure label" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/qudt> .

ns1:function a rdf:Property ;
    rdfs:label "function" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/datatype> .

ns1:functionArity a rdf:Property ;
    rdfs:label "function arity" ;
    dcterms:description "This property is used to state the number of arguments for a function type." ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/datatype> .

ns1:guidance a rdf:Property ;
    rdfs:label "guidance" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/qudt> .

ns1:hasAllowedUnit a rdf:Property ;
    rdfs:label "allowed unit" ;
    dcterms:description """
  This property relates a unit system with a unit of measure that is not defined by or part of the system,
   but is allowed for use within the system.
   An allowed unit must be convertible to some dimensionally eqiuvalent unit that is defined by the system.
  """ ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/qudt> ;
    rdfs:subPropertyOf ns1:hasUnit .

ns1:hasBaseUnit a rdf:Property ;
    rdfs:label "base unit" ;
    dcterms:description """
  This property relates a system of units to a base unit defined within the system.
  The base units of a system are used to define the derived units of the system by expressing
   the derived units as products of the base units raised to a rational power.
  """ ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/qudt> ;
    rdfs:subPropertyOf ns1:hasCoherentUnit .

ns1:hasDTICode a rdf:Property ;
    rdfs:label "has DTI code"@en ;
    rdfs:comment "ISO 24165 Digital Token Identifier (12-character alphanumeric)."@en ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/qudt> .

ns1:hasDerivedCoherentUnit a rdf:Property ;
    rdfs:label "derived coherent unit" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/qudt> ;
    rdfs:subPropertyOf ns1:hasCoherentUnit,
        ns1:hasDerivedUnit .

ns1:hasFactorUnit a rdf:Property ;
    rdfs:label "hasFactorUnit" ;
    dcterms:description "This property relates a derived unit to one of its constituent factor units"^^rdf:HTML ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/qudt> .

ns1:hasQuantityKindsList a rdf:Property ;
    rdfs:label "quantity kinds" ;
    dcterms:description "This property is used to specify a list of quantity kinds." ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/datatype> .

ns1:hasReciprocalUnit a rdf:Property ;
    rdfs:label "has reciprocal unit" ;
    dcterms:description "Used to relate a unit to its reciprocal unit." ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/qudt> .

ns1:hasReferenceQuantityKind a rdf:Property ;
    rdfs:label "has reference quantity kind" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/qudt> .

ns1:hasRule a rdf:Property ;
    rdfs:label "has rule" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/qudt> .

ns1:height a rdf:Property ;
    rdfs:label "height" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/qudt> .

ns1:hexbinary a rdfs:Datatype,
        sh:NodeShape ;
    rdfs:label "hexbinary" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/datatype> ;
    rdfs:subClassOf xsd:string ;
    sh:datatype xsd:string ;
    sh:pattern "[0-9A-F]*" .

ns1:iconicCue a rdf:Property ;
    rdfs:label "iconic cue" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/datatype> ;
    rdfs:subPropertyOf ns1:modalCue .

ns1:iconicCueEnumeration a rdf:Property ;
    rdfs:label "iconic cue enumeration" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/datatype> ;
    rdfs:subPropertyOf ns1:modalCueEnumeration .

ns1:imageLocation a rdf:Property ;
    rdfs:label "image location" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/qudt> .

ns1:incrementDatatype a rdf:Property ;
    rdfs:label "increment datatype" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/datatype> .

ns1:informativeReference a rdf:Property ;
    rdfs:label "informative reference" ;
    dcterms:description "Provides a way to reference a source that provided useful but non-normative information." ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/qudt> .

ns1:inverted a rdf:Property ;
    rdfs:label "inverted" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/datatype> .

ns1:isByteString a rdf:Property ;
    rdfs:label "is byte string" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/datatype> .

ns1:isHeterogeneous a rdf:Property ;
    rdfs:label "is heterogeneous" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/datatype> .

ns1:javaName a rdf:Property ;
    rdfs:label "java name" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/datatype> ;
    rdfs:subPropertyOf ns1:id .

ns1:jsName a rdf:Property ;
    rdfs:label "Javascript name" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/datatype> ;
    rdfs:subPropertyOf ns1:id .

