<http://qudt.org/vocab/quantitykind/RestMass> a ns1:QuantityKind ;
    rdfs:label "كتلة ساكنة"@ar,
        "Klidová hmotnost"@cs,
        "Ruhemasse"@de,
        "rest mass"@en,
        "masa invariante"@es,
        "جرم سکون"@fa,
        "masse au repos"@fr,
        "निश्चर द्रव्यमान"@hi,
        "massa a riposo"@it,
        "不変質量"@ja,
        "Jisim rehat"@ms,
        "masa spoczynkowa"@pl,
