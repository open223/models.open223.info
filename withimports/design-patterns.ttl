    ns1:hasReciprocalUnit <http://qudt.org/vocab/unit/PER-IN3> ;
    ns1:iec61360Code "0112/2///62720#UAA549" ;
    ns1:informativeReference "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA549"^^xsd:anyURI ;
