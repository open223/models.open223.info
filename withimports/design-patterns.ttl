<http://qudt.org/vocab/unit/J-SEC> a ns1:DerivedUnit,
        ns1:Unit ;
    rdfs:label "Joule Second",
        "جول ثانية"@ar,
        "Джаул Секунда"@bg,
        "Joule Sekunda"@cs,
        "Joule Sekunde"@de,
        "Τζάουλ Δευτερόλεπτο"@el,
        "Joule Second"@en,
        "Julio Segundo"@es,
        "ژول ثانیه"@fa,
        "Joule Seconde"@fr,
        "जूल सैकण्ड"@hi,
        "Joule Secondo"@it,
        "ジュール秒"@ja,
        "Joulium Secundum"@la,
        "Joule Saat"@ms,
        "Dżul Sekunda"@pl,
        "Joule Segundo"@pt,
        "Joule Secundă"@ro,
        "Джоуль Секунда"@ru,
        "Joule Sekunda"@sl,
        "Joule Saniye"@tr,
        "焦耳秒"@zh ;
    dcterms:description """
  The $\\textit{joule-second}$ is a unit equal to a $joule$ multiplied by a second, used to measure action or angular momentum.
  The joule-second is the unit used for Planck's constant.
  """^^ns1:LatexString ;
    ns1:applicableSystem <http://qudt.org/vocab/sou/CGS>,
        <http://qudt.org/vocab/sou/CGS-EMU>,
