    rdfs:isDefinedBy <http://qudt.org/3.2.1/vocab/quantitykind> .

<http://qudt.org/vocab/unit/FemtoM> a ns1:Unit ;
    rdfs:label "Femtometre",
        "Femtometr"@cs,
        "Femtometer"@de,
        "Femtometre"@en,
        "Femtometer"@en-us,
        "Femtometro"@es,
