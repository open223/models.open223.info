        "https://en.wikipedia.org/wiki/Kilometre?oldid=494821851"^^xsd:anyURI ;
    ns1:prefix <http://qudt.org/vocab/prefix/Kilo> ;
    ns1:scalingOf <http://qudt.org/vocab/unit/M> ;
