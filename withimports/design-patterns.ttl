        "https://en.wikipedia.org/wiki/Ton#Other_units_of_mass/weight"^^xsd:anyURI ;
    ns1:scalingOf <http://qudt.org/vocab/unit/KiloGM> ;
    ns1:symbol "AT" ;
    ns1:uneceCommonCode "M85" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/vocab/unit> .

