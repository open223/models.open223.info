    rdfs:isDefinedBy <http://qudt.org/3.2.1/vocab/quantitykind> ;
    skos:broader <http://qudt.org/vocab/quantitykind/Count> .

<http://qudt.org/vocab/quantitykind/VapourPermeability> a ns1:QuantityKind ;
    rdfs:label "Vapour Permeability"@en ;
