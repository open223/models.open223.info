            ns1:hasUnit <http://qudt.org/vocab/unit/SEC> ],
        [ a ns1:FactorUnit ;
            ns1:exponent 1 ;
            ns1:hasUnit <http://qudt.org/vocab/unit/M> ],
        [ a ns1:FactorUnit ;
            ns1:exponent 1 ;
            ns1:hasUnit <http://qudt.org/vocab/unit/KiloGM> ] ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/Force> ;
