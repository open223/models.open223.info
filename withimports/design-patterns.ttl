        [ a ns1:FactorUnit ;
            ns1:exponent 1 ;
            ns1:hasUnit <http://qudt.org/vocab/unit/A> ],
        [ a ns1:FactorUnit ;
            ns1:exponent 1 ;
            ns1:hasUnit <http://qudt.org/vocab/unit/HR> ] ;
