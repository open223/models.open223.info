    sh:path sh:lessThanOrEquals .

sh:MaxCountConstraintComponent-maxCount a sh:Parameter ;
    rdfs:isDefinedBy sh: ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:path sh:maxCount .

sh:MaxExclusiveConstraintComponent-maxExclusive a sh:Parameter ;
    rdfs:isDefinedBy sh: ;
