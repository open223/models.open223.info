dcterms:abstract a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "abstract" ;
    rdfs:isDefinedBy dcterms:,
        <http://qudt.org/3.2.1/schema/shacl/qudt> ;
    rdfs:range xsd:string .

dcterms:created a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "created" ;
    rdfs:isDefinedBy dcterms: ;
    rdfs:range xsd:date .

dcterms:modified a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "modified" ;
    rdfs:isDefinedBy dcterms: ;
    rdfs:range xsd:date .

dcterms:title a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "title" ;
    rdfs:isDefinedBy dcterms: ;
    rdfs:range xsd:string .

ns1:DatatypePropertyShape a sh:PropertyShape ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/datatype> ;
    sh:class ns1:Datatype ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path ns1:datatype .

ns1:DimensionsPropertyShape a sh:PropertyShape ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/datatype> ;
    sh:node ns1:IntegerListShape ;
    sh:path ns1:dimensions .

ns1:IntegerUnionList a rdf:List ;
    rdfs:label "Integer Union List" ;
    rdf:first [ sh:datatype xsd:int ] ;
    rdf:rest ( [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:positiveInteger ] [ sh:datatype xsd:integer ] ) ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/datatype> .

ns1:MaybeQuantityPropertyShape a sh:PropertyShape ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/datatype> ;
    sh:class ns1:Quantity ;
    sh:maxCount 1 ;
    sh:path ns1:quantity .

ns1:N-Tuple-elementType a sh:PropertyShape ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/datatype> ;
    sh:class ns1:Datatype ;
    sh:minCount 0 ;
    sh:path ns1:elementDatatype .

ns1:QuantityKindsPropertyShape a sh:PropertyShape ;
    dcterms:description "Invalid quantity kinds list - TODO: SPARQL Query" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/datatype> ;
    sh:node ns1:QuantityKindList ;
    sh:path ns1:hasQuantityKindsList .

ns1:RawValueTupleMember-elementType a sh:PropertyShape ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/datatype> ;
    sh:class ns1:UnsignedIntegerType ;
    sh:path ns1:elementDatatype .

ns1:Tuple-elementType a sh:PropertyShape ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/datatype> ;
    sh:class ns1:TupleMember ;
    sh:path ns1:elementDatatype .

ns1:Tuple-elementTypeCount a sh:PropertyShape ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/datatype> ;
    sh:datatype xsd:integer ;
    sh:minCount 0 ;
    sh:path ns1:elementTypeCount .

ns1:Tuple-length a sh:PropertyShape ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/datatype> ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:minCount 0 ;
    sh:path ns1:length .

ns1:UCUMcs a rdfs:Datatype,
        sh:NodeShape ;
    rdfs:label "case-sensitive UCUM code" ;
    dcterms:description "Lexical pattern for the case-sensitive version of UCUM code" ;
    dcterms:source <https://ucum.org/ucum.html> ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/qudt> ;
    rdfs:seeAlso <https://ucum.org/ucum.html> ;
    rdfs:subClassOf xsd:string .

ns1:allowedPattern a rdf:Property ;
    rdfs:label "allowed pattern" ;
    dcterms:description "This property relates a date string encoding (c.f. type:DateStringEncodingType) to one or more XML Schema compliant regular expressions that together determine the allowed lexical expressions that can be unambiguously parsed to determine a temporal quantity." ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/datatype> .

ns1:applicableSystem a rdf:Property ;
    rdfs:label "applicable system" ;
    dcterms:description """
  This property relates a unit of measure with a unit system that may or may not define the unit,
   but within which the unit is compatible.
  """ ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/qudt> .

ns1:basis a rdf:Property ;
    rdfs:label "basis" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/datatype> .

ns1:bitOrder a rdf:Property ;
    rdfs:label "bit order" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/datatype> .

ns1:byRow a rdf:Property ;
    rdfs:label "by row" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/datatype> .

ns1:byteOrder a rdf:Property ;
    rdfs:label "byte order" ;
    dcterms:description "Byte order is an enumeration of two values: 'Big Endian' and 'Little Endian' and is used to denote whether the most signiticant byte is either first or last, respectively." ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/datatype> .

ns1:bytes a rdf:Property ;
    rdfs:label "bytes" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/datatype> .

ns1:currencyCode a rdf:Property ;
    rdfs:label "currency code" ;
    dcterms:description "Alphabetic Currency Code as defined by ISO 4217. For example, the currency code for the US dollar is USD."^^rdf:HTML ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/qudt> .

ns1:currencyExponent a rdf:Property ;
    rdfs:label "currency exponent" ;
    dcterms:description """
  The currency exponent indicates the number of decimal places between a major currency unit and its minor currency unit. 
  For example, the US dollar is the major currency unit of the United States, and the US cent is the minor currency unit. Since one cent is 1/100 of a dollar, the US dollar has a currency exponent of 2. 
  However, the Japanese Yen has no minor currency units, so the yen has a currency exponent of 0.
  """ ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/qudt> .

ns1:dataStructure a rdf:Property ;
    rdfs:label "data structure" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/qudt> .

ns1:dbpediaMatch a rdf:Property ;
    rdfs:label "dbpedia match" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/qudt> .

ns1:dimensions a rdf:Property ;
    rdfs:label "dimensions" ;
    dcterms:description """
  The extent of each dimension making up an array or matrix.
  Dimensions are expressed as an integer list.
  For example a 4 by 4 array has dimensions (4 4), whereas a vector or a string has dimensions (1).
  """ ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/datatype> .

ns1:enumeration a rdf:Property ;
    rdfs:label "enumeration" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/datatype> .

ns1:exactConstant a rdf:Property ;
    rdfs:label "exact constant" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/qudt> .

ns1:expression a rdf:Property ;
    rdfs:label "expression" ;
    dcterms:description """
  An 'expression' is a finite combination of symbols that are well-formed according to rules that apply to units of measure, quantity kinds and their dimensions.
  """ ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/qudt> .

ns1:hasBaseQuantityKind a rdf:Property ;
    rdfs:label "has base quantity kind" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/qudt> ;
    rdfs:subPropertyOf ns1:hasQuantityKind .

ns1:hasUnitSystem a rdf:Property ;
    rdfs:label "has unit system" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/qudt> .

ns1:image a rdf:Property ;
    rdfs:label "image" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/qudt> .

ns1:isoNormativeReference a rdf:Property ;
    rdfs:label "normative reference (ISO)" ;
    dcterms:description "Provides a way to reference the ISO unit definition." ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/qudt> ;
    rdfs:subPropertyOf ns1:normativeReference .

ns1:lowerBound a rdf:Property ;
    rdfs:label "lower bound" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/datatype> .

ns1:maxLength a rdf:Property ;
    rdfs:label "max length" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/datatype> .

ns1:optional a rdf:Property ;
    rdfs:label "optional" .

ns1:permissibleMaths a rdf:Property ;
    rdfs:label "permissible maths" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/qudt> .

ns1:permissibleTransformation a rdf:Property ;
    rdfs:label "permissible transformation" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/qudt> .

ns1:prefix a rdf:Property ;
    rdfs:label "prefix" ;
    dcterms:description "Associates a unit with the appropriate prefix, if any." ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/qudt> .

ns1:qkdvDenominator a rdf:Property ;
    rdfs:label "denominator dimension vector" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/qudt> .

ns1:qkdvNumerator a rdf:Property ;
    rdfs:label "numerator dimension vector" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/qudt> .

ns1:quantityValue a rdf:Property ;
    rdfs:label "quantity value" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/qudt> .

ns1:rationale a rdf:Property ;
    rdfs:label "rationale" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/qudt> .

ns1:upperBound a rdf:Property ;
    rdfs:label "upper bound" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/datatype> .

ns1:url a rdf:Property ;
    rdfs:label "url" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/qudt> .

<http://qudt.org/vocab/constant/ElectromagneticPermeabilityOfVacuum> a ns1:PhysicalConstant ;
    rdfs:label "Permeability of Vacuum"@en ;
    dcterms:description """
  The $\\textit{Permeability of Vacuum}$, also known as $\\textit{Magnetic Constant}$, is a scalar constant 
  $\\mu_0$ such that, in a vacuum the product with the magnetic field vector, $\\overrightarrow{H}$ 
  is equal to the magnetic flux density vector, $\\overrightarrow{B}$.
  """^^ns1:LatexString ;
    ns1:applicableUnit <http://qudt.org/vocab/unit/H-PER-M> ;
    ns1:dbpediaMatch "http://dbpedia.org/resource/Vacuum_permeability"^^xsd:anyURI ;
    ns1:exactConstant true ;
    ns1:exactMatch <http://qudt.org/vocab/constant/MagneticConstant> ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/Permittivity> ;
    ns1:informativeReference "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=705-03-14"^^xsd:anyURI,
        "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI ;
    ns1:latexDefinition "$\\mu_0 = \\frac{\\overrightarrow{B}}{\\overrightarrow{H}}$, where $\\overrightarrow{B}$ is the B-Filed magnetic vector, and $\\overrightarrow{H}$ is the H-Field magnetic vector. The value of $\\mu_0$ is $\\approx 1.256637e-6\\,henry\\,per\\,metre$."^^ns1:LatexString ;
    ns1:latexSymbol "$\\mu_0$"^^ns1:LatexString ;
    ns1:quantityValue <http://qudt.org/vocab/constant/Value_MagneticConstant> ;
    ns1:ucumCode "[mu_0]"^^ns1:UCUMcs ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/vocab/constant> .

<http://qudt.org/vocab/constant/PermittivityOfVacuum> a ns1:PhysicalConstant ;
    rdfs:label "Permittivity of Vacuum"@en ;
    dcterms:description """
  The constant $\\textit{Permittivity of Vacuum}$, also known as the $\\textit{electric constant}$ is a constant 
  whose value is $\\approx\\,6.854188e-12\\, farad\\,per\\,metre$. Sometimes also referred to as 
  the $\\textit{Permittivity of Free Space}$.
  """^^ns1:LatexString ;
    ns1:applicableUnit <http://qudt.org/vocab/unit/FARAD-PER-M> ;
    ns1:dbpediaMatch "http://dbpedia.org/resource/Permittivity"^^xsd:anyURI ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/Permittivity> ;
    ns1:informativeReference "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI ;
    ns1:latexDefinition "$\\epsilon = \\frac{\\mathbf{D}}{\\mathbf{E}}$, where $\\mathbf{D}$ is electric flux density and $\\mathbf{E}$ is electric field strength."^^ns1:LatexString ;
    ns1:latexSymbol "$\\epsilon_0$"^^ns1:LatexString ;
    ns1:quantityValue <http://qudt.org/vocab/constant/Value_PermittivityOfVacuum> ;
    ns1:ucumCode "[eps_0]"^^ns1:UCUMcs ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/vocab/constant> ;
    rdfs:seeAlso <http://qudt.org/vocab/quantitykind/ElectricFieldStrength>,
        <http://qudt.org/vocab/quantitykind/ElectricFluxDensity>,
        <http://qudt.org/vocab/quantitykind/Permittivity> .

<http://qudt.org/vocab/constant/Value_MagneticConstant> a ns1:ConstantValue ;
    rdfs:label "Value for magnetic constant" ;
    ns1:hasUnit <http://qudt.org/vocab/unit/FARAD-PER-M> ;
    ns1:informativeReference "http://physics.nist.gov/cuu/Constants/bibliography.html"^^xsd:anyURI ;
    ns1:value 0.0000012566370614 ;
    ns1:valueSN 1.256637e-06 ;
    ns2:website "http://physics.nist.gov/cgi-bin/cuu/Value?mu0#mid"^^xsd:anyURI ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/vocab/constant> .

<http://qudt.org/vocab/constant/Value_MolarGasConstant> a ns1:ConstantValue ;
    rdfs:label "Value for molar gas constant" ;
    ns1:hasUnit <http://qudt.org/vocab/unit/J-PER-MOL-K> ;
    ns1:informativeReference "http://physics.nist.gov/cuu/Constants/bibliography.html"^^xsd:anyURI ;
    ns1:standardUncertainty 0.000015 ;
    ns1:standardUncertaintySN 1.5e-05 ;
    ns1:value 8.31446261815324 ;
    ns1:valueSN 8.314463e+00 ;
    ns2:website "http://physics.nist.gov/cgi-bin/cuu/Value?r#mid"^^xsd:anyURI ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/vocab/constant> .

<http://qudt.org/vocab/constant/Value_MolarVolumeOfIdealGas273dot15K100KiloPA> a ns1:ConstantValue ;
    rdfs:label "Value for molar volume of ideal gas 273.15 K 101.325 kPa" ;
    ns1:hasUnit <http://qudt.org/vocab/unit/M3-PER-MOL> ;
    ns1:informativeReference "http://physics.nist.gov/cuu/Constants/bibliography.html"^^xsd:anyURI ;
    ns1:standardUncertainty 0.0 ;
    ns1:standardUncertaintySN 0e+00 ;
    ns1:value 0.02271095464 ;
    ns1:valueSN 2.271095e-02 ;
    ns2:website "http://physics.nist.gov/cgi-bin/cuu/Value?mvol#mid"^^xsd:anyURI,
