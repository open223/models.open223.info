    ns1:latexSymbol "$\\overline{T_t}$"^^ns1:LatexString ;
    ns1:plainTextDescription "\"Activity Thresholds\" are thresholds of sensitivity for radioactivity." ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/vocab/quantitykind> .

