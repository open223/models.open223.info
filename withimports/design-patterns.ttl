    rdfs:label "element" ;
    dcterms:description "An element of an enumeration"^^rdf:HTML ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/qudt> .

ns1:elementKind a rdf:Property ;
    rdfs:label "element kind" ;
    dcterms:description "This property is used to describe the quantity kind for a dimensional data type." ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/datatype> ;
    rdfs:subPropertyOf ns1:elementKind .

ns1:elementLabel a rdf:Property ;
    rdfs:label "element label" ;
    dcterms:description "This property is used to label the field of a composite data structure." ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/datatype> .

ns1:elementName a rdf:Property ;
    rdfs:label "element name" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/datatype> .

ns1:elementUnit a rdf:Property ;
    rdfs:label "element unit" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/datatype> .

ns1:exactMatch a ns1:SymmetricRelation,
        rdf:Property ;
    rdfs:label "exact match" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/qudt> .

ns1:example a rdf:Property ;
    rdfs:label "example" ;
    dcterms:description """
  The 'qudt:example' property is used to annotate an instance of a class with a reference to a concept that is an example. 
  The type of this property is 'rdf:Property'. 
  This allows both scalar and object ranges.
  """ ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/qudt> .

ns1:exponent a rdf:Property ;
    rdfs:label "exponent" ;
    ns1:plainTextDescription "Defines the exponent of a factor unit" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/datatype>,
        <http://qudt.org/3.2.1/schema/shacl/qudt> .

ns1:factorUnitScalar a rdf:Property ;
    rdfs:label "factorUnitScalar" ;
    dcterms:description "For a derived unit that is not exactly the product of its factor units, this property defines the scalar with which that product has to be multiplied with."^^rdf:HTML ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/qudt> .

ns1:field a rdf:Property ;
    rdfs:label "field" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/datatype> .

