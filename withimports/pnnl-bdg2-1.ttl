            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object <https://brickschema.org/schema/BrickTag#Domestic> ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object <https://brickschema.org/schema/BrickTag#Hot> ;
