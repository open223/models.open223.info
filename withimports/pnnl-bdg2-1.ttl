    qudt:symbol "M" ;
    qudt:wikidataMatch <http://www.wikidata.org/entity/Q2596212> ;
    rdfs:comment "Applicable units are those of quantitykind:ThermalInsulance" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/vocab/quantitykind> ;
    rdfs:seeAlso qudtqk:CoefficientOfHeatTransfer .

