s223:AirHeatExchanger a s223:Class,
        sh:NodeShape ;
    rdfs:label "Air heat exchanger" ;
    rdfs:comment "A piece of `Equipment` that transfers heat from one air stream to another while keeping the two media separate." ;
    rdfs:subClassOf s223:Equipment ;
    sh:property [ rdfs:comment "An `AirHeatExchanger` shall have no bidirectional connection points." ;
            sh:message "s223: An `AirHeatExchanger` shall have no bidirectional connection points." ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMaxCount 0 ;
            sh:qualifiedValueShape [ sh:class s223:BidirectionalConnectionPoint ;
                    sh:message "s223: An `AirHeatExchanger` shall have no bidirectional connection points." ] ],
        [ rdfs:comment "An `AirHeatExchanger` shall have at least two outlets using the medium `Fluid-Air`, each paired with an inlet." ;
            sh:message "s223: An `AirHeatExchanger` shall have at least two outlets using the medium `Fluid-Air`, each paired with an inlet." ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 2 ;
            sh:qualifiedValueShape [ sh:class s223:OutletConnectionPoint ;
                    sh:node [ sh:property [ sh:class s223:Fluid-Air ;
                                    sh:path s223:hasMedium ],
                                [ sh:class s223:InletConnectionPoint ;
                                    sh:minCount 1 ;
                                    sh:path s223:pairedConnectionPoint ] ] ] ],
        [ rdfs:comment "An `AirHeatExchanger` shall have at least two inlets using the medium `Fluid-Air`, each paired with an outlet." ;
            sh:message "s223: An `AirHeatExchanger` shall have at least two inlets using the medium `Fluid-Air`, each paired with an outlet." ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 2 ;
            sh:qualifiedValueShape [ sh:class s223:InletConnectionPoint ;
                    sh:node [ sh:property [ sh:class s223:OutletConnectionPoint ;
                                    sh:minCount 1 ;
                                    sh:path s223:pairedConnectionPoint ],
                                [ sh:class s223:Fluid-Air ;
                                    sh:path s223:hasMedium ] ] ] ] .

s223:Aspect-Alarm a s223:Aspect-Alarm,
        s223:Class,
        sh:NodeShape ;
    rdfs:label "Alarm" ;
    rdfs:comment "The property value indicates whether an alarm condition is active or provides details about an active alarm." ;
    rdfs:subClassOf s223:EnumerationKind-Aspect .

s223:Aspect-CatalogNumber a s223:Aspect-CatalogNumber,
        s223:Class,
        sh:NodeShape ;
    rdfs:label "Catalog number" ;
    rdfs:comment "The property value is a number or other identifier of a product in a manufacturer’s catalog." ;
    rdfs:subClassOf s223:EnumerationKind-Aspect .

s223:Aspect-Deadband a s223:Aspect-Deadband,
        s223:Class,
        sh:NodeShape ;
    rdfs:label "Deadband" ;
    rdfs:comment "The property value is a range around a setpoint where no control action is taken to avoid unnecessary corrections." ;
    rdfs:subClassOf s223:EnumerationKind-Aspect .

s223:Aspect-Fault a s223:Aspect-Fault,
        s223:Class,
        sh:NodeShape ;
    rdfs:label "Fault" ;
    rdfs:comment "The property value is a fault indicator or code that signals a malfunction or issue with the system or equipment." ;
    rdfs:subClassOf s223:EnumerationKind-Aspect .

s223:Aspect-HighLimit a s223:Aspect-HighLimit,
        s223:Class,
        sh:NodeShape ;
    rdfs:label "High limit" ;
    rdfs:comment "The property value is an upper threshold used in a control or alarm detection algorithm." ;
    rdfs:subClassOf s223:EnumerationKind-Aspect .

s223:Aspect-LowLimit a s223:Aspect-LowLimit,
        s223:Class,
        sh:NodeShape ;
    rdfs:label "Low limit" ;
    rdfs:comment "The property value is a lower threshold used in a control or alarm detection algorithm." ;
    rdfs:subClassOf s223:EnumerationKind-Aspect .

s223:Aspect-Manufacturer a s223:Aspect-Manufacturer,
        s223:Class,
        sh:NodeShape ;
    rdfs:label "Manufacturer" ;
    rdfs:comment "The property value is a name or other identifier of the product’s manufacturer." ;
    rdfs:subClassOf s223:EnumerationKind-Aspect .

s223:Aspect-Maximum a s223:Aspect-Maximum,
        s223:Class,
        sh:NodeShape ;
    rdfs:label "Maximum" ;
    rdfs:comment "The property value is a highest specified or observed value. (Examples: upper limit of the specified operating voltage range; maximum measured temperature.)" ;
    rdfs:subClassOf s223:EnumerationKind-Aspect .

s223:Aspect-Minimum a s223:Aspect-Minimum,
        s223:Class,
        sh:NodeShape ;
    rdfs:label "Minimum" ;
    rdfs:comment "The property value is a lowest specified or observed value. (Examples: lower limit of the specified operating voltage range; minimum measured temperature.)" ;
    rdfs:subClassOf s223:EnumerationKind-Aspect .

s223:Aspect-Nominal a s223:Aspect-Nominal,
        s223:Class,
        sh:NodeShape ;
    rdfs:label "Nominal" ;
    rdfs:comment "The property value is a value that is expected or desired under normal operating conditions, but may not reflect the actual value at all times. (Example: nominal voltage.)" ;
    rdfs:subClassOf s223:EnumerationKind-Aspect .

s223:Aspect-OperatingMode a s223:Aspect-OperatingMode,
        s223:Class,
        sh:NodeShape ;
    rdfs:label "Operating mode" ;
    rdfs:comment "The property value is the current intended mode of operation, such as 'Automatic', 'On', or 'Off'." ;
    rdfs:subClassOf s223:EnumerationKind-Aspect .

s223:Aspect-OperatingStatus a s223:Aspect-OperatingStatus,
        s223:Class,
        sh:NodeShape ;
    rdfs:label "Operating status" ;
    rdfs:comment "The property value is the current operational status of the system or equipment, such as 'Running,' 'Stopped,' or 'Maintenance Mode.'" ;
    rdfs:subClassOf s223:EnumerationKind-Aspect .

s223:Aspect-Rated a s223:Aspect-Rated,
        s223:Class,
        sh:NodeShape ;
    rdfs:label "Rated" ;
    rdfs:comment "The property value indicates a limit for continuous safe operation set by the manufacturer, but may not reflect the actual value at all times. (Example: rated voltage.)" ;
    rdfs:subClassOf s223:EnumerationKind-Aspect .

s223:Aspect-SerialNumber a s223:Aspect-SerialNumber,
