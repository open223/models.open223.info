            qudt:hasUnit unit:M ],
        [ a qudt:FactorUnit ;
            qudt:exponent 1 ;
            qudt:hasUnit unit:SEC ] ;
    qudt:hasQuantityKind qudtqk:AcousticImpedance ;
    qudt:hasReciprocalUnit unit:M-PER-SEC-PA ;
    qudt:iec61360Code "0112/2///62720#UAA268" ;
