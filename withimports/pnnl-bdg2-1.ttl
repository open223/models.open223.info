    qudt:latexSymbol "$\\overline{T_t}$"^^qudt:LatexString ;
    qudt:plainTextDescription "\"Activity Thresholds\" are thresholds of sensitivity for radioactivity." ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/vocab/quantitykind> .

