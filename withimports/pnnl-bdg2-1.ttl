ns2:GraphRole a owl:Class ;
    rdfs:label "Graph role" ;
    dcterms:description "GraphRole is used to characterize how a graph of resources participates in an ontology set.  For example, a graph can be a schema, vocabulary, dataset, script, or ruleset" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/2.0/schema/vaem>,
        <http://www.linkedmodel.org/schema/vaem> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ns2:filePrefix ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ns2:description ],
        owl:Thing .

