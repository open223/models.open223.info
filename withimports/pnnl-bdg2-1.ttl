    qudt:symbol "0173-1#Z4-BAJ462#001" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/vocab/quantitykind> .

qudtqk:TransmissionRatioBetweenRotationAndTranslation a qudt:QuantityKind ;
