    qudt:iec61360Code "0112/2///62720#UAD144" ;
    qudt:informativeReference "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD144"^^xsd:anyURI ;
    qudt:plainTextDescription "Differenzdruck dividiert durch die zugehörige Länge"@de ;
