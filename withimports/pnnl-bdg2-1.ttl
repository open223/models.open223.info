        <https://brickschema.org/schema/BrickTag#Computer>,
        <https://brickschema.org/schema/BrickTag#Equipment>,
        <https://brickschema.org/schema/BrickTag#Handler>,
        <https://brickschema.org/schema/BrickTag#Room> .

brick:Conductivity_Sensor a owl:Class,
        sh:NodeShape ;
    rdfs:label "Conductivity Sensor" ;
    rdfs:subClassOf brick:Sensor ;
    skos:definition "Measures electrical conductance"@en ;
    sh:rule [ a sh:TripleRule ;
            sh:object <https://brickschema.org/schema/BrickTag#Point> ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object <https://brickschema.org/schema/BrickTag#Sensor> ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object <https://brickschema.org/schema/BrickTag#Conductivity> ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
