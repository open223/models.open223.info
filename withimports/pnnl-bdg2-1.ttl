brick:Sensor a owl:Class,
        sh:NodeShape ;
    rdfs:label "Sensor" ;
    rdfs:seeAlso "https://xp20.ashrae.org/terminology/index.php?term=Sensor" ;
    rdfs:subClassOf brick:Point ;
    owl:disjointWith brick:Alarm,
        brick:Command,
        brick:Parameter,
        brick:Setpoint,
        brick:Status ;
    skos:definition "A Sensor is an input point that represents the value of a device or instrument designed to detect and measure a variable (ASHRAE Dictionary)."@en ;
    sh:rule [ a sh:TripleRule ;
            sh:object <https://brickschema.org/schema/BrickTag#Point> ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object <https://brickschema.org/schema/BrickTag#Sensor> ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag <https://brickschema.org/schema/BrickTag#Point>,
        <https://brickschema.org/schema/BrickTag#Sensor> .

<https://brickschema.org/schema/BrickTag#Exhaust> a brick:Tag ;
