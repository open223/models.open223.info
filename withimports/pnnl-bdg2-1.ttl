qudtqk:SurfaceActivityDensity a qudt:QuantityKind ;
    rdfs:label "Surface Activity Density"@en ;
    dcterms:description "The \"Surface Activity Density\" is undefined."^^qudt:LatexString ;
    qudt:applicableUnit unit:BQ-PER-M2 ;
