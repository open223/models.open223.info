            sh:object <https://brickschema.org/schema/BrickTag#CO> ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object <https://brickschema.org/schema/BrickTag#Level> ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object <https://brickschema.org/schema/BrickTag#Sensor> ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
