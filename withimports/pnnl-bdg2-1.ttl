            qudt:exponent -1 ;
            qudt:hasUnit unit:GM ] ;
    qudt:hasQuantityKind qudtqk:SpecificElectricCharge ;
    qudt:symbol "mA·h/g" ;
    qudt:ucumCode "mA.h.g-1"^^qudt:UCUMcs ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/vocab/unit> .

