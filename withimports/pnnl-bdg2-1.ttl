unit:MIN_Angle a qudt:Unit ;
    rdfs:label "Minute Angle",
        "Minute Angle"@en ;
    dcterms:description """
  An arcminute, minute of arc, or minute arc (MOA), is a unit of angle equal to one sixtieth (1/60) of one degree, or 1/21600 of a turn, or $\\pi /10800$ radians, or 60 arcseconds.
  The SI symbol for arcminute is '.
  Not to be confused with the time minute (unit:MIN), which is a unit of measurement of time, equal to 60 seconds or to 1/60 of a hour.
  """^^qudt:LatexString ;
    qudt:applicableSystem <http://qudt.org/vocab/sou/ASU>,
        <http://qudt.org/vocab/sou/CGS>,
        <http://qudt.org/vocab/sou/CGS-EMU>,
