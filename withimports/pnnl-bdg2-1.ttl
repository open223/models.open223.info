<https://brickschema.org/schema/BrickShape#CoolingCapacityShape> a owl:Class,
        sh:NodeShape ;
    rdfs:subClassOf <https://brickschema.org/schema/BrickShape#ValueShape> ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or <https://brickschema.org/schema/BrickShape#NumericValue> ;
            sh:path brick:value ],
        [ a sh:PropertyShape ;
            sh:in ( unit:TON_FG unit:BTU_IT-PER-HR unit:BTU_TH-PER-HR unit:W ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path brick:hasUnit ] .

<https://brickschema.org/schema/BrickShape#CoordinateShape> a owl:Class,
        sh:NodeShape ;
    rdfs:subClassOf <https://brickschema.org/schema/BrickShape#ValueShape> ;
    sh:property [ a sh:PropertyShape ;
            sh:minCount 1 ;
            sh:or <https://brickschema.org/schema/BrickShape#NumericValue> ;
            sh:path brick:longitude ],
        [ a sh:PropertyShape ;
            sh:minCount 1 ;
            sh:or <https://brickschema.org/schema/BrickShape#NumericValue> ;
            sh:path brick:latitude ] .

<https://brickschema.org/schema/BrickShape#CurrentFlowTypeShape> a owl:Class,
        sh:NodeShape ;
    rdfs:subClassOf <https://brickschema.org/schema/BrickShape#ValueShape> ;
    sh:property [ a sh:PropertyShape ;
            sh:in ( "AC" "DC" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path brick:value ] .

<https://brickschema.org/schema/BrickShape#LastKnownValueShape> a owl:Class,
        sh:NodeShape ;
    rdfs:subClassOf <https://brickschema.org/schema/BrickShape#ValueShape> ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path brick:value ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:dateTime ;
            sh:minCount 1 ;
            sh:path brick:timestamp ] .

<https://brickschema.org/schema/BrickShape#PhaseCountShape> a owl:Class,
        sh:NodeShape ;
    rdfs:subClassOf <https://brickschema.org/schema/BrickShape#ValueShape> ;
    sh:property [ a sh:PropertyShape ;
            sh:in ( "1" "2" "3" "Total" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path brick:value ] .

<https://brickschema.org/schema/BrickShape#PhasesShape> a owl:Class,
        sh:NodeShape ;
    rdfs:subClassOf <https://brickschema.org/schema/BrickShape#ValueShape> ;
    sh:property [ a sh:PropertyShape ;
            sh:in ( "A" "B" "C" "AB" "BC" "AC" "ABC" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path brick:value ] .

<https://brickschema.org/schema/BrickShape#PowerComplexityShape> a owl:Class,
        sh:NodeShape ;
    rdfs:subClassOf <https://brickschema.org/schema/BrickShape#ValueShape> ;
    sh:property [ a sh:PropertyShape ;
