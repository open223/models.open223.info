            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag <https://brickschema.org/schema/BrickTag#Cool>,
        <https://brickschema.org/schema/BrickTag#Equipment>,
        <https://brickschema.org/schema/BrickTag#Valve> .

