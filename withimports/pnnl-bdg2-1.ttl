            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object <https://brickschema.org/schema/BrickTag#Location> ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag <https://brickschema.org/schema/BrickTag#Location>,
        <https://brickschema.org/schema/BrickTag#Room> .

