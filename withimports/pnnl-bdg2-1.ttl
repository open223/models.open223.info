    qudt:dbpediaMatch "http://dbpedia.org/resource/Area"^^xsd:anyURI ;
    qudt:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T0D0> ;
    qudt:iec61360Code "0112/2///62720#UAD182" ;
    qudt:informativeReference "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD182"^^xsd:anyURI ;
    qudt:plainTextDescription "Area is a quantity expressing the two-dimensional size of a defined part of a surface, typically a region bounded by a closed curve." ;
    qudt:siExactMatch <https://si-digital-framework.org/quantities/AREA> ;
    qudt:wikidataMatch <http://www.wikidata.org/entity/Q11500> ;
    rdfs:comment "Applicable units are those of quantitykind:Area" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/vocab/quantitykind> ;
    skos:altLabel "superficie"@fr .

<https://brickschema.org/schema/BrickTag#Equipment> a brick:Tag ;
    rdfs:label "Equipment" .

qudtqk:Unknown a qudt:QuantityKind ;
