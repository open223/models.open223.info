qudt:NumericTypeUnion a rdf:List ;
    rdfs:label "Numeric Type Union" ;
    dcterms:description """
  An rdf:List that can be used in property constraints as value for sh:or to indicate that all values
   of a property must be a string, an integer, a float, a double or a decimal.
  """ ;
    rdf:first [ sh:datatype xsd:string ] ;
    rdf:rest ( [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:positiveInteger ] [ sh:datatype xsd:integer ] [ sh:datatype xsd:int ] [ sh:datatype xsd:float ] [ sh:datatype xsd:double ] [ sh:datatype xsd:decimal ] ) ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/schema/shacl/qudt> .

