        "área"@pt,
        "arie"@ro,
        "Площадь"@ru,
        "površina"@sl,
        "alan"@tr,
        "面积"@zh ;
    dcterms:description "Area is a quantity expressing the two-dimensional size of a defined part of a surface, typically a region bounded by a closed curve."^^qudt:LatexString ;
    qudt:applicableUnit unit:AC,
        unit:ARE,
        unit:BARN,
        unit:CentiM2,
        unit:DecaARE,
        unit:DeciM2,
