    qudt:derivedCoherentUnitOfSystem <http://qudt.org/vocab/sou/SI> ;
    qudt:expression "$W sr^{-1}$"^^qudt:LatexString ;
    qudt:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-3D0> ;
