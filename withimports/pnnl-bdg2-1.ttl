            sh:object <https://brickschema.org/schema/BrickTag#Panel> ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object <https://brickschema.org/schema/BrickTag#Equipment> ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object <https://brickschema.org/schema/BrickTag#Solar> ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
