        <https://brickschema.org/schema/BrickTag#Point>,
        <https://brickschema.org/schema/BrickTag#Sensor>,
        <https://brickschema.org/schema/BrickTag#Trace> .

brick:Transfer_Fan a owl:Class,
        sh:NodeShape ;
    rdfs:label "Transfer Fan" ;
