unit:K-PER-W a qudt:DerivedUnit,
        qudt:Unit ;
    rdfs:label "Kelvin per Watt",
        "Келвин на Ват"@bg,
        "Kelvin na Watt"@cs,
        "Kelvin pro Watt"@de,
        "Κέλβιν ανά Βατ"@el,
        "Kelvin per Watt"@en,
        "Kelvin por Vatio"@es,
        "Kelvin par Watt"@fr,
        "Kelvin per Watt"@it,
        "Kelvin per Wattium"@la,
        "Kelvin per Watt"@ms,
