    qudt:ucumCode "da" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/vocab/prefix> .

<http://qudt.org/vocab/prefix/Deci> a qudt:DecimalPrefix,
        qudt:Prefix ;
    rdfs:label "Deci",
        "Deci"@en ;
    dcterms:description "\"deci\" is a decimal prefix for expressing a value with a scaling of \\(10^{-1}\\)."^^qudt:LatexString ;
    qudt:dbpediaMatch "http://dbpedia.org/resource/Deci-"^^xsd:anyURI ;
    qudt:informativeReference "https://en.wikipedia.org/wiki/Deci-?oldid=469980160"^^xsd:anyURI ;
