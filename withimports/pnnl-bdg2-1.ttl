    qudt:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E4L-6I0M-2H0T6D0> ;
    qudt:informativeReference "https://www.neonscience.org/data-samples/data-management/data-processing"^^xsd:anyURI ;
