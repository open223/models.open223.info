                            sh:construct "CONSTRUCT {$this rdf:type <https://brickschema.org/schema/Brick#Leaving_Domestic_Hot_Water_Temperature_Sensor> .} WHERE {$this rdf:type <https://brickschema.org/schema/Brick#Domestic_Hot_Water_Discharge_Temperature_Sensor> . }" ;
                            sh:prefixes <http://data.ashrae.org/standard223/1.0/data/pnnl-bdg2-1> ] ;
                    sh:targetClass brick:Domestic_Hot_Water_Discharge_Temperature_Sensor ] ;
            brick:deprecationMitigationMessage "Swapped supply/return for entering/leaving with water-related points" ] .

