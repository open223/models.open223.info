    qudt:hasFactorUnit [ a qudt:FactorUnit ;
            qudt:exponent -2 ;
            qudt:hasUnit unit:SEC ],
        [ a qudt:FactorUnit ;
            qudt:exponent 1 ;
            qudt:hasUnit unit:CentiM ] ;
    qudt:hasQuantityKind qudtqk:Acceleration,
        qudtqk:LinearAcceleration ;
    qudt:iec61360Code "0112/2///62720#UAB042" ;
