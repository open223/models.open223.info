    qudt:informativeReference "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=113-01-34"^^xsd:anyURI,
        "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI ;
