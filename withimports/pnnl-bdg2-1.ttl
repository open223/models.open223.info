        "https://en.wikipedia.org/wiki/Bushel?oldid=476704875"^^xsd:anyURI ;
    qudt:scalingOf unit:M3 ;
    qudt:symbol "bsh{UK}" ;
    qudt:ucumCode "[bu_br]"^^qudt:UCUMcs ;
    qudt:uneceCommonCode "BUI" ;
    qudt:wikidataMatch <http://www.wikidata.org/entity/Q89473028> ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/vocab/unit> .

