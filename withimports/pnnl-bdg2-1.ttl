    qudt:informativeReference "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA539"^^xsd:anyURI,
        "https://en.wikipedia.org/wiki/Inch?oldid=492522790"^^xsd:anyURI ;
