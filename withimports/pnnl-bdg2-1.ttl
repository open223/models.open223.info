    ns2:hasOwner ns2:QUDT ;
    ns2:hasSteward ns2:QUDT ;
    ns2:intent "Specifies the schema for quantities, units and dimensions. Types are defined in other schemas." ;
    ns2:isMetadataFor <http://qudt.org/3.2.1/shacl/qudt-all> ;
    ns2:logo "https://qudt.org/linkedmodels.org/assets/lib/lm/images/logos/qudt_logo-300x110.png"^^xsd:anyURI ;
