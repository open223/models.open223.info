            qudt:exponent 1 ;
            qudt:hasUnit unit:HR ],
        [ a qudt:FactorUnit ;
            qudt:exponent 1 ;
            qudt:hasUnit unit:A ] ;
    qudt:hasQuantityKind qudtqk:Unknown ;
