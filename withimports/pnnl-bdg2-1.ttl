            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path brick:value ] .

<https://brickschema.org/schema/BrickShape#VolumeShape> a owl:Class,
        sh:NodeShape ;
    rdfs:subClassOf <https://brickschema.org/schema/BrickShape#ValueShape> ;
    sh:property [ a sh:PropertyShape ;
            sh:in ( unit:FT3 unit:M3 ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
