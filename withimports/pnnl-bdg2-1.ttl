unit:N-PER-C a qudt:DerivedUnit,
        qudt:Unit ;
    rdfs:label "Newton per Coulomb",
        "Нютон на Кулон"@bg,
        "Newton na Coulomb"@cs,
        "Newton pro Coulomb"@de,
