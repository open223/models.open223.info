brick:Discharge_Air_Temperature_Sensor a owl:Class,
        sh:NodeShape ;
    rdfs:label "Discharge Air Temperature Sensor" ;
    rdfs:subClassOf brick:Air_Temperature_Sensor ;
    skos:definition "Measures the temperature of discharge air"@en ;
