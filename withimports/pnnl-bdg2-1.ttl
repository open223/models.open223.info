unit:KiloGM-PER-M-SEC2 a qudt:DerivedUnit,
        qudt:Unit ;
    rdfs:label "Kilogram per Metre Square Second",
        "Килограм на Метър Квадратен Секунда"@bg,
        "Kilogram na Metr Čtvereční Sekunda"@cs,
        "Kilogramm pro Meter Quadratsekunde"@de,
        "Χιλιόγραμμο ανά Μέτρο Τετραγωνικό Δευτερόλεπτο"@el,
        "Kilogram per Metre Square Second"@en,
        "Kilograms per metre per square second"@en,
        "Kilogram per Meter Square Second"@en-us,
        "Kilogramo por Metro Segundo Cuadrado"@es,
        "Kilogramme par Mètre Seconde Carré"@fr,
        "Chilogrammo per Metro Secondo Quadrato"@it,
        "Chiliogramma per Metrum Secundum Quadratum"@la,
        "Kilogram per Meter Saat Persegi"@ms,
        "Kilogram na Metr Sekunda Kwadratowy"@pl,
        "Quilograma por Metro Segundo Quadrado"@pt,
        "Kilogram pe Metru Secundă Pătrat"@ro,
        "Килограмм на Метр Квадратный Секунда"@ru,
        "Kilogram na Meter Kvadratni Sekunda"@sl,
        "Kilogram per Metre Saniyekare"@tr ;
    dcterms:description "The SI unit of pressure. The pascal is the standard pressure unit in the MKS metric system, equal to one newton per square meter or one \"kilogram per meter per second per second.\" The unit is named for Blaise Pascal (1623-1662), French philosopher and mathematician, who was the first person to use a barometer to measure differences in altitude."^^rdf:HTML ;
    qudt:applicableSystem <http://qudt.org/vocab/sou/CGS>,
        <http://qudt.org/vocab/sou/CGS-EMU>,
        <http://qudt.org/vocab/sou/CGS-GAUSS>,
        <http://qudt.org/vocab/sou/SI> ;
    qudt:conversionMultiplier 1.0 ;
    qudt:conversionMultiplierSN 1e+00 ;
    qudt:dbpediaMatch "http://dbpedia.org/resource/Pascal"^^xsd:anyURI ;
    qudt:exactMatch unit:N-PER-M2,
        unit:PA ;
    qudt:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0> ;
    qudt:hasFactorUnit [ a qudt:FactorUnit ;
            qudt:exponent -2 ;
            qudt:hasUnit unit:SEC ],
        [ a qudt:FactorUnit ;
            qudt:exponent 1 ;
            qudt:hasUnit unit:KiloGM ],
        [ a qudt:FactorUnit ;
            qudt:exponent -1 ;
            qudt:hasUnit unit:M ] ;
    qudt:hasQuantityKind qudtqk:ForcePerArea,
        qudtqk:VapourPressure ;
    qudt:siUnitsExpression "kg/m/s^2" ;
    qudt:symbol "Pa",
        "kg/(m·s²)" ;
    qudt:ucumCode "kg.m-1.s-2"^^qudt:UCUMcs ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/vocab/unit> .

