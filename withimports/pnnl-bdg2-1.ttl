    qudt:hasFactorUnit [ a qudt:FactorUnit ;
            qudt:exponent -1 ;
            qudt:hasUnit unit:LB_F ],
        [ a qudt:FactorUnit ;
            qudt:exponent 1 ;
            qudt:hasUnit unit:BTU_IT ] ;
