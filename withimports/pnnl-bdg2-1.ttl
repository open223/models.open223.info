            qudt:exponent 1 ;
            qudt:hasUnit unit:TON_LONG ] ;
    qudt:hasQuantityKind qudtqk:Density,
        qudtqk:MassDensity ;
    qudt:symbol "t{long}/yd³" ;
    qudt:ucumCode "[lton_av].[yd_i]-3"^^qudt:UCUMcs ;
    qudt:uneceCommonCode "L92" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/vocab/unit> .

