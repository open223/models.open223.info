            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object <https://brickschema.org/schema/BrickTag#Isolation> ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
