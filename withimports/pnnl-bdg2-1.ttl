    qudt:symbol "N_i" ;
    qudt:wikidataMatch <http://www.wikidata.org/entity/Q98690787> ;
    rdfs:comment "Applicable units are those of quantitykind:TotalIonization" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/vocab/quantitykind> .

