        <https://brickschema.org/schema/BrickTag#Gas>,
        <https://brickschema.org/schema/BrickTag#Natural> .

brick:Occupancy a brick:Quantity ;
    rdfs:label "Occupancy" .

brick:Occupied_Discharge_Air_Flow_Setpoint a owl:Class,
