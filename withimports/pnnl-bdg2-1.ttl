    qudt:iec61360Code "0112/2///62720#UAB040" ;
    qudt:informativeReference "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB040"^^xsd:anyURI ;
    qudt:symbol "yd³/min" ;
    qudt:ucumCode "[yd_i]3.min-1"^^qudt:UCUMcs ;
    qudt:uneceCommonCode "M15" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/vocab/unit> .

