            qudt:exponent -1 ;
            qudt:hasUnit unit:LB ],
        [ a qudt:FactorUnit ;
            qudt:exponent 1 ;
            qudt:hasUnit unit:HR ],
        [ a qudt:FactorUnit ;
            qudt:exponent 1 ;
            qudt:hasUnit unit:FT ] ;
    qudt:hasQuantityKind qudtqk:Unknown ;
