        <https://brickschema.org/schema/BrickTag#Temperature> ;
    brick:hasQuantity brick:Temperature ;
    brick:hasSubstance brick:Return_Air .

brick:Return_Water_Temperature_Sensor a owl:Class ;
    rdfs:label "Return Water Temperature Sensor" ;
    rdfs:subClassOf brick:Water_Temperature_Sensor ;
    owl:deprecated true ;
    brick:deprecation [ brick:deprecatedInVersion "1.3.0" ;
            brick:deprecationMigitationRule [ a sh:NodeShape ;
                    sh:rule [ a sh:SPARQLRule ;
                            sh:construct "CONSTRUCT {$this rdf:type <https://brickschema.org/schema/Brick#Entering_Water_Temperature_Sensor> .} WHERE {$this rdf:type <https://brickschema.org/schema/Brick#Return_Water_Temperature_Sensor> . }" ;
                            sh:prefixes <http://data.ashrae.org/standard223/1.0/data/pnnl-bdg2-1> ] ;
                    sh:targetClass brick:Return_Water_Temperature_Sensor ] ;
            brick:deprecationMitigationMessage "Swapped supply/return for entering/leaving with water-related points" ] .

brick:Room_Air_Temperature_Setpoint a owl:Class,
