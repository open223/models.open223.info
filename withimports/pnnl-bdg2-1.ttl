brick:Frost a owl:Class,
        sh:NodeShape,
        brick:Frost ;
    rdfs:label "Frost" ;
    rdfs:subClassOf brick:Solid ;
    skos:definition "frost formed on the cold surface (tubes, plates) of a cooling coil."@en ;
