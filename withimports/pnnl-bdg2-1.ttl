            sh:object <https://brickschema.org/schema/BrickTag#Point> ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object <https://brickschema.org/schema/BrickTag#Head> ;
            sh:predicate brick:hasTag ;
