    qudt:symbol "rayl_MKS" ;
    qudt:wikidataMatch <http://www.wikidata.org/entity/Q359151> ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/vocab/unit> ;
    rdfs:seeAlso unit:RAYL .

