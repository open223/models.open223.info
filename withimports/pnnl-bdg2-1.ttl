brick:PM2.5_Sensor a owl:Class,
        sh:NodeShape ;
    rdfs:label "PM2.5 Sensor" ;
    rdfs:subClassOf brick:Particulate_Matter_Sensor ;
    skos:definition "Detects matter of size 2.5 microns"@en ;
