    qudt:plainTextDescription "\"Particle Source Density\" is the rate of production of particles in a 3D domain divided by the volume of that element." ;
    qudt:symbol "S" ;
    qudt:wikidataMatch <http://www.wikidata.org/entity/Q98915762> ;
    rdfs:comment "Applicable units are those of quantitykind:ParticleSourceDensity" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/vocab/quantitykind> .

