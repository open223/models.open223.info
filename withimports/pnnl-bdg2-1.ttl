brick:Supply_Hot_Water_Temperature_Setpoint a owl:Class ;
    rdfs:label "Supply Hot Water Temperature Setpoint" ;
    rdfs:subClassOf brick:Supply_Water_Temperature_Sensor ;
    owl:deprecated true ;
    brick:deprecation [ brick:deprecatedInVersion "1.3.0" ;
            brick:deprecationMigitationRule [ a sh:NodeShape ;
                    sh:rule [ a sh:SPARQLRule ;
                            sh:construct "CONSTRUCT {$this rdf:type <https://brickschema.org/schema/Brick#Leaving_Hot_Water_Temperature_Setpoint> .} WHERE {$this rdf:type <https://brickschema.org/schema/Brick#Supply_Hot_Water_Temperature_Setpoint> . }" ;
                            sh:prefixes <http://data.ashrae.org/standard223/1.0/data/pnnl-bdg2-1> ] ;
                    sh:targetClass brick:Supply_Hot_Water_Temperature_Setpoint ] ;
            brick:deprecationMitigationMessage "Swapped supply/return for entering/leaving with water-related points" ] .

brick:Supply_Water_Flow_Setpoint a owl:Class ;
    rdfs:label "Supply Water Flow Setpoint" ;
    rdfs:subClassOf brick:Water_Flow_Setpoint ;
    owl:deprecated true ;
    brick:deprecation [ brick:deprecatedInVersion "1.3.0" ;
            brick:deprecationMigitationRule [ a sh:NodeShape ;
                    sh:rule [ a sh:SPARQLRule ;
                            sh:construct "CONSTRUCT {$this rdf:type <https://brickschema.org/schema/Brick#Leaving_Water_Flow_Setpoint> .} WHERE {$this rdf:type <https://brickschema.org/schema/Brick#Supply_Water_Flow_Setpoint> . }" ;
                            sh:prefixes <http://data.ashrae.org/standard223/1.0/data/pnnl-bdg2-1> ] ;
                    sh:targetClass brick:Supply_Water_Flow_Setpoint ] ;
            brick:deprecationMitigationMessage "Swapped supply/return for entering/leaving with water-related points" ] .

