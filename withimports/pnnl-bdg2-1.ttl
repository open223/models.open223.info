            qudt:exponent 1 ;
            qudt:hasUnit unit:KiloGM ] ;
    qudt:hasQuantityKind qudtqk:MassFlowRate,
        qudtqk:MassPerTime ;
    qudt:iec61360Code "0112/2///62720#UAA607" ;
