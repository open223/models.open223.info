qudtqk:RestMass a qudt:QuantityKind ;
    rdfs:label "كتلة ساكنة"@ar,
        "Klidová hmotnost"@cs,
        "Ruhemasse"@de,
        "rest mass"@en,
        "masa invariante"@es,
        "جرم سکون"@fa,
        "masse au repos"@fr,
        "निश्चर द्रव्यमान"@hi,
        "massa a riposo"@it,
