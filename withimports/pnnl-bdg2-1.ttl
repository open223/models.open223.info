                            sh:construct "CONSTRUCT {$this rdf:type <https://brickschema.org/schema/Brick#Differential_Leaving_Return_Water_Temperature_Sensor> .} WHERE {$this rdf:type <https://brickschema.org/schema/Brick#Differential_Supply_Return_Water_Temperature_Sensor> . }" ;
                            sh:prefixes <http://data.ashrae.org/standard223/1.0/data/pnnl-bdg2-1> ] ;
