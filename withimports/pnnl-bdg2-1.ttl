    qudt:symbol "I_{y}" ;
    rdfs:comment "Applicable units are those of quantitykind:MomentOfInertia" ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/vocab/quantitykind> ;
    skos:altLabel "MOI" ;
    skos:broader qudtqk:MomentOfInertia .

qudtqk:MomentOfInertia_Z a qudt:QuantityKind ;
    rdfs:label "Moment of Inertia in the Z axis"@en ;
