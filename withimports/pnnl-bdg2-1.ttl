    qudt:conversionMultiplierSN 2.777778e-04 ;
    qudt:expression "$kg/h$"^^qudt:LatexString ;
    qudt:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T-1D0> ;
