                    sh:rule [ a sh:SPARQLRule ;
                            sh:construct "CONSTRUCT {$this rdf:type <https://brickschema.org/schema/Brick#Leaving_Chilled_Water> .} WHERE {$this rdf:type <https://brickschema.org/schema/Brick#Supply_Chilled_Water> . }" ;
