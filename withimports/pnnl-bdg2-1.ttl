        "uzaklık"@tr,
        "距离"@zh ;
    dcterms:description "\"Distance\" is a numerical description of how far apart objects are. "^^qudt:LatexString ;
    qudt:applicableUnit unit:MI,
        unit:MIL_Length,
        unit:MI_UK,
