            qudt:hasUnit unit:GM ],
        [ a qudt:FactorUnit ;
            qudt:exponent 1 ;
            qudt:hasUnit unit:A ] ;
    qudt:hasQuantityKind qudtqk:SpecificElectricCurrent ;
    qudt:symbol "A/g" ;
    qudt:ucumCode "A.g-1"^^qudt:UCUMcs ;
    rdfs:isDefinedBy <http://qudt.org/3.2.1/vocab/unit> .

