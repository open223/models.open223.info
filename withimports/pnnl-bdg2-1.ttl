    qudt:conversionMultiplierSN 2.123763e-04 ;
    qudt:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E0L3I0M0H0T-1D0> ;
    qudt:hasFactorUnit [ a qudt:FactorUnit ;
